---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Stats from "../components/Stats.astro";
import Commitment from "../components/Commitment.astro";
import Revolution from "../components/Revolution.astro";
import Subsidy from "../components/Subsidy.astro";
import Projects from "../components/Projects.astro";
import Payment from "../components/Payment.astro";
import Process from "../components/Process.astro";
import Reviews from "../components/Reviews.astro";
import FinalCta from "../components/FinalCta.astro";
import Footer from "../components/Footer.astro";
import LeadDialog from "../components/LeadDialog.astro";
import MobileCta from "../components/MobileCta.astro";
---

<Layout>
	<Header />
	<main class="relative z-10 bg-paper shadow-[0_30px_60px_-15px_rgba(0,0,0,0.6)]">
		<Hero />
		<Stats />
		<Commitment />
		<Revolution />
		<Subsidy />
		<Projects />
		<Payment />
		<Process />
		<Reviews />
		<FinalCta />
	</main>
	<Footer />
	<LeadDialog />
	<MobileCta />
</Layout>
