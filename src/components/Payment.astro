---
import Icon from "./Icon.astro";

const options = [
	{
		number: "01",
		title: "Upfront payment",
		icon: "wallet" as const,
		copy: "Pay according to the agreed quotation and payment milestones. Eligible subsidy may be credited separately through the scheme process.",
	},
	{
		number: "02",
		title: "Solar financing",
		icon: "building" as const,
		copy: "Explore eligible bank or lender financing, subject to credit assessment, interest rates, tenure and lender approval.",
	},
	{
		number: "03",
		title: "Understand your monthly EMI",
		icon: "chart" as const,
		copy: "Compare an illustrative repayment with your current electricity spend, so the cash-flow impact is clear before you commit.",
	},
];
---

<section id="payment" class="relative isolate overflow-hidden bg-ink py-18 text-paper sm:py-22 lg:py-28">
	<div class="solar-grid-light pointer-events-none absolute inset-0 opacity-35"></div>
	<div class="aurora -z-10 opacity-25"></div>
	<div class="pointer-events-none absolute -right-48 top-0 h-[620px] w-[620px] rounded-full border border-solar/10"></div>
	<div class="pointer-events-none absolute -left-32 bottom-0 h-80 w-80 rounded-full bg-forest/20 blur-3xl"></div>

	<div class="container-page relative">
		<div class="grid gap-12 lg:grid-cols-[1.02fr_0.98fr] lg:items-center lg:gap-16 xl:gap-20">
			<div class="reveal">
				<p class="eyebrow text-solar">Your investment</p>
				<h2 class="display mt-5 max-w-[600px] text-[2.6rem] text-paper sm:text-[3.2rem] lg:text-[3.55rem]">
					A solar system, <em class="text-solar">on your terms.</em>
				</h2>
				<p class="mt-5 max-w-[460px] text-[12.5px] leading-[1.9] text-white/55 sm:text-[13.5px]">
					Three clear routes — pay upfront, explore finance, or understand the monthly number
					first. No pressure either way.
				</p>

				<div class="mt-9 border-t border-white/10">
					{
						options.map((option) => (
							<div class="group grid gap-4 border-b border-white/10 py-5 sm:grid-cols-[auto_1fr] sm:gap-5 lg:py-6">
								<div class="flex items-center gap-3 sm:flex-col sm:items-start">
									<span class="text-[8px] font-semibold tracking-[0.18em] text-solar/70">{option.number}</span>
									<span class="flex h-9 w-9 items-center justify-center rounded-full border border-white/10 bg-white/[0.045] text-solar transition-colors duration-300 group-hover:border-solar/35 group-hover:bg-solar/10">
										<Icon name={option.icon} class="h-3.5 w-3.5" />
									</span>
								</div>
								<div class="flex items-start justify-between gap-4">
									<div>
										<h3 class="text-[14px] font-semibold text-white/90 sm:text-[15px]">{option.title}</h3>
										<p class="mt-1.5 max-w-[500px] text-[10.5px] leading-[1.8] text-white/45">
											{option.copy}
										</p>
									</div>
									<svg
										class="mt-1 h-3.5 w-3.5 shrink-0 text-white/20 transition-all duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-solar/70"
										viewBox="0 0 16 16"
										fill="none"
										stroke="currentColor"
										stroke-width="1.5"
										aria-hidden="true"
									>
										<path d="M4 12 12 4M5 4h7v7" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
								</div>
							</div>
						))
					}
				</div>

				<div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
					<a href="#estimate" class="btn-solar">
						Explore My Options
						<svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
							<path d="M2.5 8h10M8.5 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</a>
					<p class="max-w-[300px] text-[8.5px] leading-[1.6] text-white/35">
						NIRT does not provide loans directly. Financing is subject to lender assessment
						and approval.
					</p>
				</div>
			</div>

			<div class="reveal w-full lg:justify-self-end" style="transition-delay:100ms">
				<div class="edge-gold-dark relative w-full max-w-[480px] rounded-[32px] p-[1px] shadow-[0_40px_100px_-30px_rgba(0,0,0,0.65)] lg:ml-auto">
					<div class="grain relative overflow-hidden rounded-[31px] bg-[#f8f1e2] p-5 text-ink sm:p-7">
						<div class="pointer-events-none absolute -right-20 -top-24 h-56 w-56 rounded-full bg-solar/30 blur-3xl"></div>
						<div class="pointer-events-none absolute -bottom-24 -left-20 h-48 w-48 rounded-full bg-forest/10 blur-3xl"></div>

						<div class="relative z-[2]">
							<div class="flex items-start justify-between gap-4">
								<div>
									<p class="text-[8px] font-semibold uppercase tracking-[0.18em] text-forest">
										Illustrative EMI
									</p>
									<p class="mt-1 text-[9px] text-moss">A feel for the monthly number</p>
								</div>
								<span class="rounded-full border border-ink/10 bg-white/60 px-2.5 py-1 text-[7.5px] font-semibold uppercase tracking-[0.12em] text-ink/50">
									Indicative
								</span>
							</div>

							<div class="mt-7 flex flex-wrap items-end gap-x-2 gap-y-1">
								<p class="font-sans text-[3.2rem] font-semibold leading-none tracking-[-0.06em] tabular-nums sm:text-[3.6rem]" data-emi-output aria-live="polite">
									₹2,125
								</p>
								<p class="mb-1.5 text-[11px] text-moss">/ month</p>
							</div>
							<p class="mt-2 text-[9.5px] text-moss" data-emi-sub>
								At 10% p.a. over 5 years
							</p>

							<div class="my-5 h-px bg-ink/10"></div>

							<div class="flex items-baseline justify-between gap-4">
								<label for="emi-loan" class="text-[8px] font-semibold uppercase tracking-[0.15em] text-moss">
									Loan amount
								</label>
								<span class="font-sans text-[13px] font-semibold tabular-nums text-ink" data-loan-output>₹1,00,000</span>
							</div>
							<input
								id="emi-loan"
								class="emi-range mt-3.5"
								type="range"
								min="50000"
								max="300000"
								step="10000"
								value="100000"
								style="--range-progress:20%"
								aria-label="Illustrative loan amount"
								aria-valuetext="₹1,00,000"
								data-loan-range
							/>
							<div class="mt-2 flex justify-between text-[7.5px] uppercase tracking-[0.1em] text-moss/55">
								<span>₹50,000</span>
								<span>₹3,00,000</span>
							</div>

							<fieldset class="mt-5">
								<legend class="text-[8px] font-semibold uppercase tracking-[0.15em] text-moss">
									Repayment tenure
								</legend>
								<div class="mt-2 grid grid-cols-3 gap-1 rounded-full border border-ink/10 bg-ink/[0.045] p-1">
									{
										[3, 5, 7].map((years) => (
											<button
												type="button"
												class:list={[
													"rounded-full px-2 py-2 text-[9.5px] font-semibold transition",
													years === 5
														? "bg-ink text-paper shadow-sm"
														: "text-moss hover:bg-white/60 hover:text-ink",
												]}
												data-tenure={years}
												aria-pressed={years === 5 ? "true" : "false"}
											>
												{years} years
											</button>
										))
									}
								</div>
							</fieldset>

							<div class="mt-5 grid grid-cols-2 gap-3">
								<div class="rounded-xl border border-ink/10 bg-white/45 p-3">
									<p class="text-[7.5px] font-semibold uppercase tracking-[0.12em] text-moss">Loan amount</p>
									<p class="mt-1 text-[12px] font-semibold tabular-nums" data-loan-detail>₹1,00,000</p>
								</div>
								<div class="rounded-xl border border-ink/10 bg-white/45 p-3">
									<p class="text-[7.5px] font-semibold uppercase tracking-[0.12em] text-moss">Estimated interest</p>
									<p class="mt-1 text-[12px] font-semibold tabular-nums" data-interest-output>₹27,500</p>
								</div>
							</div>

							<div class="mt-4 rounded-xl border border-ink/10 bg-white/45 p-3.5">
								<div class="flex items-center justify-between text-[8px] font-semibold uppercase tracking-[0.1em] text-moss">
									<span>Principal</span>
									<span>Interest</span>
								</div>
								<div class="mt-2 flex h-2 overflow-hidden rounded-full bg-ink/10">
									<span class="h-full bg-forest transition-all duration-300" data-bar-principal style="width:78%"></span>
									<span class="h-full bg-solar transition-all duration-300" data-bar-interest style="width:22%"></span>
								</div>
								<div class="mt-2 flex items-center justify-between text-[8px] text-moss/70">
									<span class="flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-forest"></span><span data-principal-output>₹1,00,000</span></span>
									<span class="flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-solar"></span><span data-total-interest-output>₹27,500</span></span>
								</div>
							</div>

							<div class="mt-4 flex items-start gap-2 text-[8px] leading-[1.65] text-moss/70">
								<Icon name="shield" class="mt-0.5 h-3 w-3 shrink-0 text-forest/70" />
								<p>
									Illustrative only, assuming 10% p.a. on a reducing balance. Actual EMI
									depends on lender terms, fees and approved amount. This is not a financing
									offer.
								</p>
							</div>

							<a href="#estimate" class="group mt-4 inline-flex items-center gap-2 text-[9.5px] font-semibold text-ink transition-colors hover:text-forest">
								Talk through the numbers
								<svg class="h-3 w-3 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
									<path d="M2.5 8h10M8.5 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</a>
						</div>
					</div>
				</div>
				<p class="mt-3 text-center text-[8px] leading-4 text-white/25 lg:text-right">
					Adjust the loan amount and tenure to see an indicative repayment.
				</p>
			</div>
		</div>
	</div>
</section>

<script>
	const range = document.querySelector<HTMLInputElement>("[data-loan-range]");
	const tenureButtons = document.querySelectorAll<HTMLButtonElement>("[data-tenure]");
	const emiOutput = document.querySelector<HTMLElement>("[data-emi-output]");
	const emiSub = document.querySelector<HTMLElement>("[data-emi-sub]");
	const loanOutput = document.querySelector<HTMLElement>("[data-loan-output]");
	const loanDetail = document.querySelector<HTMLElement>("[data-loan-detail]");
	const interestOutput = document.querySelector<HTMLElement>("[data-interest-output]");
	const principalOutput = document.querySelector<HTMLElement>("[data-principal-output]");
	const totalInterestOutput = document.querySelector<HTMLElement>("[data-total-interest-output]");
	const principalBar = document.querySelector<HTMLElement>("[data-bar-principal]");
	const interestBar = document.querySelector<HTMLElement>("[data-bar-interest]");

	const formatRupees = (value: number) => `₹${new Intl.NumberFormat("en-IN").format(Math.round(value))}`;
	const rate = 0.1;

	const calculate = (principal: number, years: number) => {
		const monthlyRate = rate / 12;
		const months = years * 12;
		const factor = Math.pow(1 + monthlyRate, months);
		const emi = (principal * monthlyRate * factor) / (factor - 1);
		return { emi, total: emi * months };
	};

	let tenure = 5;

	const render = () => {
		if (!range) return;

		const principal = Number(range.value);
		const { emi, total } = calculate(principal, tenure);
		const interest = total - principal;
		const principalShare = Math.max(4, Math.min(96, (principal / total) * 100));
		const interestShare = 100 - principalShare;
		const progress = ((principal - Number(range.min)) / (Number(range.max) - Number(range.min))) * 100;

		range.style.setProperty("--range-progress", `${progress}%`);
		range.setAttribute("aria-valuetext", formatRupees(principal));

		if (emiOutput) emiOutput.textContent = formatRupees(emi);
		if (emiSub) emiSub.textContent = `At 10% p.a. over ${tenure} years`;
		if (loanOutput) loanOutput.textContent = formatRupees(principal);
		if (loanDetail) loanDetail.textContent = formatRupees(principal);
		if (interestOutput) interestOutput.textContent = formatRupees(interest);
		if (principalOutput) principalOutput.textContent = formatRupees(principal);
		if (totalInterestOutput) totalInterestOutput.textContent = formatRupees(interest);
		if (principalBar) principalBar.style.width = `${principalShare}%`;
		if (interestBar) interestBar.style.width = `${interestShare}%`;
	};

	range?.addEventListener("input", render);

	tenureButtons.forEach((button) => {
		button.addEventListener("click", () => {
			tenure = Number(button.dataset.tenure ?? 5);
			tenureButtons.forEach((item) => {
				const active = item === button;
				item.setAttribute("aria-pressed", String(active));
				item.classList.toggle("bg-ink", active);
				item.classList.toggle("text-paper", active);
				item.classList.toggle("shadow-sm", active);
				item.classList.toggle("text-moss", !active);
			});
			render();
		});
	});

	render();
</script>
