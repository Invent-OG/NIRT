---
import HugeIcon from "./HugeIcon.astro";
import type { IconName } from "../icons";

const options: { number: string; title: string; icon: IconName; copy: string }[] = [
	{
		number: "01",
		title: "Upfront payment",
		icon: "wallet",
		copy: "Pay according to the agreed quotation and payment milestones. Eligible subsidy may be credited separately through the scheme process.",
	},
	{
		number: "02",
		title: "Solar financing",
		icon: "bank",
		copy: "Explore eligible bank or lender financing, subject to credit assessment, interest rates, tenure and lender approval.",
	},
	{
		number: "03",
		title: "Understand the monthly number",
		icon: "calculator",
		copy: "Compare an illustrative repayment with your current electricity spend, so the cash-flow impact is clear before you commit.",
	},
];
---

<section id="payment" class="relative overflow-hidden bg-teal py-20 text-white sm:py-24 lg:py-28">
	<div class="solar-grid-light pointer-events-none absolute inset-0 opacity-[0.14]"></div>
	<div class="pointer-events-none absolute -right-40 top-0 h-[520px] w-[520px] rounded-full border border-yellow/15"></div>

	<div class="container-page relative">
		<div class="flex items-center justify-between gap-4 border-b border-white/15 pb-4">
			<p class="meta text-white/50">Investment</p>
			<p class="meta text-white/30">06 / Payment</p>
		</div>

		<div class="mt-12 grid gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:gap-16">
			<div class="reveal">
				<h2 class="display max-w-[520px] text-[2.6rem] leading-[0.98] text-white sm:text-[3.3rem] lg:text-[3.9rem]">
					A solar system, on your terms.
				</h2>
				<p class="mt-5 max-w-[430px] text-[13.5px] leading-[1.8] text-white/60">
					Three clear routes — pay upfront, explore finance, or understand the monthly number
					first. No pressure either way.
				</p>

				<div class="mt-9 border-t border-white/15">
					{
						options.map((option) => (
							<div class="group grid gap-4 border-b border-white/15 py-5 sm:grid-cols-[auto_1fr] sm:gap-5">
								<div class="flex items-center gap-3 sm:flex-col sm:items-start">
									<span class="meta text-yellow">{option.number}</span>
									<span class="grid h-9 w-9 place-items-center border border-white/18 text-white/70 transition-colors group-hover:border-yellow group-hover:text-yellow">
										<HugeIcon name={option.icon} class="h-4 w-4" />
									</span>
								</div>
								<div>
									<h3 class="text-[14.5px] font-medium text-white/95">{option.title}</h3>
									<p class="mt-1.5 max-w-[480px] text-[12px] leading-[1.75] text-white/50">
										{option.copy}
									</p>
								</div>
							</div>
						))
					}
				</div>

				<div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
					<a href="#estimate" class="btn-primary">
						Explore my options
						<HugeIcon name="arrowRight" class="h-4 w-4" />
					</a>
					<p class="max-w-[290px] text-[10.5px] leading-[1.6] text-white/35">
						NIRT does not provide loans directly. Financing is subject to lender assessment and
						approval.
					</p>
				</div>
			</div>

			<div class="reveal w-full lg:justify-self-end" style="transition-delay:100ms">
				<div class="relative mx-auto w-full max-w-[500px] lg:ml-auto">
					<div class="border border-ink/20 bg-[#fcfaf4] p-5 text-ink shadow-[0_45px_110px_-40px_rgba(0,0,0,0.6)] sm:p-7">
						<div class="flex items-start justify-between gap-4">
							<div>
								<p class="meta text-ink/40">Illustrative EMI</p>
								<p class="mt-1 text-[12px] text-ink/55">A feel for the monthly number</p>
							</div>
							<span class="meta border border-ink/15 px-2 py-1 text-ink/50">Indicative</span>
						</div>

						<div class="mt-7 flex flex-wrap items-end gap-x-2 gap-y-1">
							<p
								class="stat-number text-[3.2rem] leading-none text-ink sm:text-[3.7rem]"
								data-emi-output
								aria-live="polite"
							>
								₹2,125
							</p>
							<p class="mb-1.5 text-[12px] text-muted">/ month</p>
						</div>
						<p class="mt-2 text-[12px] text-ink/55" data-emi-sub>At 10% p.a. over 5 years</p>

						<div class="my-5 h-px bg-ink/12"></div>

						<div class="flex items-baseline justify-between gap-4">
							<label for="emi-loan" class="meta text-ink/50">Loan amount</label>
							<span class="text-[14px] font-medium tabular-nums text-ink" data-loan-output>
								₹1,00,000
							</span>
						</div>
						<input
							id="emi-loan"
							class="emi-range mt-4"
							type="range"
							min="50000"
							max="300000"
							step="10000"
							value="100000"
							style="--range-progress:20%"
							aria-label="Illustrative loan amount"
							aria-valuetext="₹1,00,000"
							data-loan-range
						/>
						<div class="mt-2 flex justify-between text-[10px] uppercase tracking-[0.08em] text-ink/35">
							<span>₹50,000</span>
							<span>₹3,00,000</span>
						</div>

						<fieldset class="mt-5">
							<legend class="meta text-ink/50">Repayment tenure</legend>
							<div class="mt-2 grid grid-cols-3 border border-ink/15">
								{
									[3, 5, 7].map((years) => (
										<button
											type="button"
											class:list={[
												"px-2 py-2.5 text-[12px] font-medium transition",
												years === 5 ? "bg-ink text-white" : "text-ink/60 hover:bg-ink/5 hover:text-ink",
											]}
											data-tenure={years}
											aria-pressed={years === 5 ? "true" : "false"}
										>
											{years} years
										</button>
									))
								}
							</div>
						</fieldset>

						<div class="mt-5 grid grid-cols-2 gap-3">
							<div class="border border-ink/12 bg-ink/[0.03] p-3">
								<p class="meta text-ink/40">Loan amount</p>
								<p class="mt-1 text-[13px] font-medium tabular-nums text-ink" data-loan-detail>₹1,00,000</p>
							</div>
							<div class="border border-ink/12 bg-ink/[0.03] p-3">
								<p class="meta text-ink/40">Estimated interest</p>
								<p class="mt-1 text-[13px] font-medium tabular-nums text-ink" data-interest-output>₹27,500</p>
							</div>
						</div>

						<div class="mt-4 border border-ink/12 bg-ink/[0.03] p-3.5">
							<div class="flex items-center justify-between text-[10px] uppercase tracking-[0.1em] text-ink/40">
								<span>Principal</span>
								<span>Interest</span>
							</div>
							<div class="mt-2 flex h-1.5 overflow-hidden bg-ink/10">
								<span class="h-full bg-ink transition-all duration-300" data-bar-principal style="width:78%"></span>
								<span class="h-full bg-yellow transition-all duration-300" data-bar-interest style="width:22%"></span>
							</div>
							<div class="mt-2 flex items-center justify-between text-[10.5px] text-ink/45">
								<span class="flex items-center gap-1.5">
									<span class="h-1.5 w-1.5 bg-ink"></span>
									<span data-principal-output>₹1,00,000</span>
								</span>
								<span class="flex items-center gap-1.5">
									<span class="h-1.5 w-1.5 bg-yellow"></span>
									<span data-total-interest-output>₹27,500</span>
								</span>
							</div>
						</div>

						<div class="mt-4 flex items-start gap-2 text-[10.5px] leading-[1.6] text-ink/45">
							<HugeIcon name="shield" class="mt-0.5 h-3.5 w-3.5 shrink-0 text-green" />
							<p>
								Illustrative only, assuming 10% p.a. on a reducing balance. Actual EMI depends
								on lender terms, fees and approved amount. This is not a financing offer.
							</p>
						</div>

						<a href="#estimate" class="link-arrow mt-4 text-ink hover:text-green">
							Talk through the numbers
							<HugeIcon name="arrowRight" class="h-3.5 w-3.5" />
						</a>
					</div>
				</div>
				<p class="mt-3 text-center text-[10px] leading-4 text-white/30 lg:text-right">
					Adjust the loan amount and tenure to see an indicative repayment.
				</p>
			</div>
		</div>
	</div>
</section>

<script>
	const range = document.querySelector<HTMLInputElement>("[data-loan-range]");
	const tenureButtons = document.querySelectorAll<HTMLButtonElement>("[data-tenure]");
	const emiOutput = document.querySelector<HTMLElement>("[data-emi-output]");
	const emiSub = document.querySelector<HTMLElement>("[data-emi-sub]");
	const loanOutput = document.querySelector<HTMLElement>("[data-loan-output]");
	const loanDetail = document.querySelector<HTMLElement>("[data-loan-detail]");
	const interestOutput = document.querySelector<HTMLElement>("[data-interest-output]");
	const principalOutput = document.querySelector<HTMLElement>("[data-principal-output]");
	const totalInterestOutput = document.querySelector<HTMLElement>("[data-total-interest-output]");
	const principalBar = document.querySelector<HTMLElement>("[data-bar-principal]");
	const interestBar = document.querySelector<HTMLElement>("[data-bar-interest]");

	const formatRupees = (value: number) => `₹${new Intl.NumberFormat("en-IN").format(Math.round(value))}`;
	const rate = 0.1;

	const calculate = (principal: number, years: number) => {
		const monthlyRate = rate / 12;
		const months = years * 12;
		const factor = Math.pow(1 + monthlyRate, months);
		const emi = (principal * monthlyRate * factor) / (factor - 1);
		return { emi, total: emi * months };
	};

	let tenure = 5;

	const render = () => {
		if (!range) return;

		const principal = Number(range.value);
		const { emi, total } = calculate(principal, tenure);
		const interest = total - principal;
		const principalShare = Math.max(4, Math.min(96, (principal / total) * 100));
		const interestShare = 100 - principalShare;
		const progress = ((principal - Number(range.min)) / (Number(range.max) - Number(range.min))) * 100;

		range.style.setProperty("--range-progress", `${progress}%`);
		range.setAttribute("aria-valuetext", formatRupees(principal));

		if (emiOutput) emiOutput.textContent = formatRupees(emi);
		if (emiSub) emiSub.textContent = `At 10% p.a. over ${tenure} years`;
		if (loanOutput) loanOutput.textContent = formatRupees(principal);
		if (loanDetail) loanDetail.textContent = formatRupees(principal);
		if (interestOutput) interestOutput.textContent = formatRupees(interest);
		if (principalOutput) principalOutput.textContent = formatRupees(principal);
		if (totalInterestOutput) totalInterestOutput.textContent = formatRupees(interest);
		if (principalBar) principalBar.style.width = `${principalShare}%`;
		if (interestBar) interestBar.style.width = `${interestShare}%`;
	};

	range?.addEventListener("input", render);

	tenureButtons.forEach((button) => {
		button.addEventListener("click", () => {
			tenure = Number(button.dataset.tenure ?? 5);
			tenureButtons.forEach((item) => {
				const active = item === button;
				item.setAttribute("aria-pressed", String(active));
				item.classList.toggle("bg-ink", active);
				item.classList.toggle("text-white", active);
				item.classList.toggle("text-ink/60", !active);
			});
			render();
		});
	});

	render();
</script>
