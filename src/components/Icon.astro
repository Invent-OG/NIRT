---
interface Props {
	name:
		| "arrow-right"
		| "arrow-up-right"
		| "check"
		| "sun"
		| "home"
		| "building"
		| "factory"
		| "leaf"
		| "shield"
		| "chart"
		| "map-pin"
		| "wallet"
		| "bolt"
		| "star"
		| "spark";
	class?: string;
}

const { name, class: className = "h-5 w-5" } = Astro.props;

const paths: Record<string, string[]> = {
	"arrow-right": ["M4 12h15", "m13 6 6 6-6 6"],
	"arrow-up-right": ["M7 17 17 7", "M8 7h9v9"],
	check: ["m5 12.5 4.5 4.5L19 7.5"],
	sun: [
		"M12 8a4 4 0 1 1 0 8 4 4 0 0 1 0-8Z",
		"M12 2v2.5",
		"M12 19.5V22",
		"M2 12h2.5",
		"M19.5 12H22",
		"m4.9 4.9 1.8 1.8",
		"m17.3 17.3 1.8 1.8",
		"m19.1 4.9-1.8 1.8",
		"m6.7 17.3-1.8 1.8",
	],
	home: ["M3 10.5 12 3l9 7.5", "M5.5 9.5V21h13V9.5", "M10 21v-6h4v6"],
	building: [
		"M4 21V5h10v16",
		"M14 10h6v11",
		"M2 21h20",
		"M7.5 9h3M7.5 13h3M7.5 17h3M17 14h.5M17 18h.5",
	],
	factory: [
		"M3 21V11l5 3v-3l5 3V8h8v13",
		"M2 21h20",
		"M7 21v-5h4v5",
		"M18 12h.5M18 16h.5",
	],
	leaf: ["M20 4C11 4 5 8 5 15c0 2 1 4 3 4 7 0 12-5 12-15Z", "M4 21c2-6 6-10 12-13"],
	shield: [
		"M12 3l7 3v5c0 4.8-2.9 8.2-7 10-4.1-1.8-7-5.2-7-10V6l7-3Z",
		"m9 12 2.1 2.1L15.5 10",
	],
	chart: ["M4 20V10", "M10 20V4", "M16 20v-7", "M2 20h20"],
	"map-pin": [
		"M12 21s7-6.4 7-11a7 7 0 1 0-14 0c0 4.6 7 11 7 11Z",
		"M12 13.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z",
	],
	wallet: [
		"M4 6.5h14A2 2 0 0 1 20 8.5v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-13a2 2 0 0 1 2-2h11",
		"M4 6.5v2.7h16",
		"M16 13h2",
	],
	bolt: ["m13 2-8 12h6l-1 8 8-12h-6l1-8Z"],
	star: ["M12 2.6l2.7 5.9 6.4.7-4.8 4.3 1.3 6.3L12 16.6l-5.6 3.2 1.3-6.3-4.8-4.3 6.4-.7L12 2.6Z"],
	spark: [
		"M12 3v4",
		"M12 17v4",
		"M3 12h4",
		"M17 12h4",
		"m5.6 5.6 2.8 2.8",
		"m15.6 15.6 2.8 2.8",
		"m18.4 5.6-2.8 2.8",
		"m8.4 15.6-2.8 2.8",
	],
};

const isFilled = name === "star";
const iconPaths = paths[name] ?? paths.sun;
---

<svg
	class={className}
	viewBox="0 0 24 24"
	fill={isFilled ? "currentColor" : "none"}
	stroke={isFilled ? "none" : "currentColor"}
	stroke-width="1.7"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	{iconPaths.map((d) => <path d={d} />)}
</svg>
