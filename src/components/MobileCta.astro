---
import HugeIcon from "./HugeIcon.astro";
---

<div
	class="fixed inset-x-0 bottom-0 z-40 hidden border-t border-navy/10 bg-white/92 px-3 pt-2.5 shadow-[0_-18px_40px_-30px_rgba(11,31,58,0.4)] backdrop-blur-xl sm:hidden"
	style="padding-bottom: max(0.7rem, env(safe-area-inset-bottom));"
	data-mobile-cta
>
	<div class="mx-auto flex max-w-[520px] items-center gap-2.5">
		<a
			href="tel:+919655046464"
			aria-label="Call NIRT Renewable Energy"
			class="flex h-11 w-12 shrink-0 items-center justify-center rounded-none border border-navy/12 bg-cloud text-navy transition-colors hover:bg-navy-tint"
		>
			<HugeIcon name="phone" class="h-4 w-4" />
		</a>
		<a href="#estimate" class="btn-primary h-11 flex-1 !min-h-11 !px-4 text-[10.5px]">
			<HugeIcon name="sun" class="h-3.5 w-3.5" />
			Get My Solar Estimate
			<HugeIcon name="arrowRight" class="h-3.5 w-3.5" />
		</a>
	</div>
</div>

<script>
	const bar = document.querySelector<HTMLElement>("[data-mobile-cta]");
	const hero = document.querySelector<HTMLElement>("#home");
	const estimate = document.querySelector<HTMLElement>("#estimate");

	if (bar) {
		let heroVisible = true;
		let estimateVisible = false;

		const updateBar = () => {
			bar.classList.toggle("hidden", heroVisible || estimateVisible);
		};

		if (hero) {
			const heroObserver = new IntersectionObserver(
				(entries) => {
					heroVisible = entries[0]?.isIntersecting ?? false;
					updateBar();
				},
				{ threshold: 0 },
			);
			heroObserver.observe(hero);
		}

		if (estimate) {
			const estimateObserver = new IntersectionObserver(
				(entries) => {
					estimateVisible = entries[0]?.isIntersecting ?? false;
					updateBar();
				},
				{ threshold: 0.02, rootMargin: "0px 0px -40px 0px" },
			);
			estimateObserver.observe(estimate);
		}
	}
</script>
