---
import HugeIcon from "./HugeIcon.astro";
---

<div
	class="fixed inset-x-0 bottom-0 z-40 hidden border-t border-white/15 bg-navy/95 px-3 pt-2.5 shadow-[0_-18px_40px_-20px_rgba(0,0,0,0.6)] backdrop-blur-xl sm:hidden"
	style="padding-bottom: max(0.7rem, env(safe-area-inset-bottom));"
	data-mobile-cta
>
	<div class="mx-auto flex max-w-[520px] items-center gap-2.5">
		<a
			href="tel:+919655046464"
			aria-label="Call NIRT Renewable Energy"
			class="flex h-11 w-12 shrink-0 items-center justify-center border border-white/25 text-white transition-colors hover:border-yellow hover:text-yellow"
		>
			<HugeIcon name="phone" class="h-4 w-4" />
		</a>
		<a href="#estimate" class="btn-primary h-11 flex-1 !min-h-11 !px-4 !text-[11.5px]">
			<HugeIcon name="sun" class="h-3.5 w-3.5" />
			Get my solar estimate
			<HugeIcon name="arrowRight" class="h-3.5 w-3.5" />
		</a>
	</div>
</div>

<script>
	const bar = document.querySelector<HTMLElement>("[data-mobile-cta]");
	const hero = document.querySelector<HTMLElement>("#home");
	const estimate = document.querySelector<HTMLElement>("#estimate");

	if (bar && hero) {
		const updateBar = () => {
			const heroRect = hero.getBoundingClientRect();
			const heroVisible = heroRect.bottom > 0 && heroRect.top < window.innerHeight;

			let estimateVisible = false;
			if (estimate) {
				const rect = estimate.getBoundingClientRect();
				estimateVisible = rect.top < window.innerHeight * 0.82 && rect.bottom > 110;
			}

			bar.classList.toggle("hidden", heroVisible || estimateVisible);
		};

		updateBar();
		window.addEventListener("scroll", updateBar, { passive: true });
		window.addEventListener("resize", updateBar);
	}
</script>
