---
import HugeIcon from "./HugeIcon.astro";
import type { IconName } from "../icons";

const points: { icon: IconName; title: string; copy: string }[] = [
	{ icon: "file", title: "Subsidy & approvals", copy: "Applications, documents and DISCOM follow-up." },
	{ icon: "chart", title: "Net metering", copy: "Export what you don't use, credit what you do." },
	{ icon: "support", title: "Support after handover", copy: "Monitoring, maintenance and performance checks." },
];
---

<section id="about" class="relative overflow-hidden bg-paper py-20 sm:py-24 lg:py-32">
	<p
		class="pointer-events-none absolute -right-8 top-24 select-none font-display text-[27vw] font-semibold leading-[0.7] tracking-[-0.07em] text-ink/[0.045] lg:top-16"
		aria-hidden="true"
	>
		NIRT
	</p>
	<svg
		class="pointer-events-none absolute left-[30%] top-[31%] hidden h-[240px] w-[400px] lg:block"
		viewBox="0 0 420 260"
		fill="none"
		aria-hidden="true"
	>
		<path
			class="scribble"
			d="M10 210c60-14 70-78 30-96-38-17-58 34-18 52 52 23 100-44 92-92-7-41-58-38-62 4-4 48 66 78 120 56 48-20 60-72 20-96-32-19-62 6-58 42 5 44 66 70 116 52 38-13 52-48 30-70"
		></path>
	</svg>

	<div class="container-page relative">
		<div class="flex flex-wrap items-center justify-between gap-3 border-t border-ink/15 pt-4">
			<p class="meta text-ink/50">About</p>
			<p class="meta text-ink/50">NIRT Renewable Energy</p>
			<p class="meta text-ink/30">©2026</p>
		</div>

		<div class="mt-14 grid gap-10 lg:mt-20 lg:grid-cols-12 lg:items-start lg:gap-8">
			<div class="reveal lg:col-span-8">
				<h2 class="display max-w-[760px] text-[2.5rem] leading-[1.02] text-ink sm:text-[3.4rem] lg:text-[4.2rem]">
					Our commitment to renewable energy excellence.
				</h2>
				<p class="mt-6 flex max-w-[430px] items-start gap-2.5 text-[13.5px] leading-[1.8] text-body">
					<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-yellow" aria-hidden="true"></span>
					Making clean power accessible, affordable and genuinely local — from a 3 kW rooftop to a
					15 MW solar park.
				</p>
			</div>

			<div class="reveal lg:col-span-4" style="transition-delay:100ms">
				<figure class="ml-auto max-w-[300px]">
					<img
						src="/images/project-rooftop.webp"
						alt="An industrial rooftop solar installation by NIRT"
						width="1400"
						height="875"
						loading="lazy"
						decoding="async"
						class="h-[190px] w-full object-cover"
					/>
					<figcaption class="mt-2 flex items-center justify-between gap-3 border-t border-ink/15 pt-2">
						<span class="meta text-ink/40">Since 2017</span>
						<span class="meta text-ink/30">Salem, Tamil Nadu</span>
					</figcaption>
				</figure>
			</div>
		</div>

		<div class="mt-12 grid gap-5 lg:mt-16 lg:grid-cols-12">
			<div class="reveal grain grain-dark relative flex flex-col overflow-hidden bg-navy p-6 text-white sm:p-7 lg:col-span-5">
				<div class="relative z-[2] flex gap-4">
					<img
						src="/images/project-solar-park.webp"
						alt="NIRT's 15 MW solar park at Harur"
						width="1100"
						height="688"
						loading="lazy"
						class="h-[84px] w-[104px] shrink-0 object-cover opacity-80"
					/>
					<div>
						<p class="meta text-white/40">Get a quote today</p>
						<p class="display mt-2 max-w-[240px] text-[1.25rem] leading-[1.15] text-white">
							Ready to harness the power of the sun?
						</p>
					</div>
				</div>
				<a href="#estimate" class="btn-primary relative z-[2] mt-6 !min-h-[2.6rem] !px-4 !text-[11px]">
					Get a free quote
					<HugeIcon name="arrowUpRight" class="h-3.5 w-3.5" />
				</a>
				<div class="relative z-[2] mt-auto flex items-center justify-between gap-3 border-t border-white/15 pt-4">
					<span class="meta text-white/40">35+ MW installed</span>
					<span class="meta text-white/30">15 MW park</span>
				</div>
				<div class="pointer-events-none absolute -bottom-16 -right-10 h-40 w-40 rounded-full border border-yellow/20"></div>
			</div>

			<div class="reveal lg:col-span-7 lg:pl-6" style="transition-delay:80ms">
				<p class="max-w-[520px] text-[14.5px] leading-[1.85] text-body">
					NIRT designs, installs and supports solar systems across Tamil Nadu. We handle the
					site assessment, the engineering, the subsidy paperwork and the handover — so the
					transition feels less like a purchase and more like an upgrade.
				</p>

				<div class="mt-7 grid gap-5 sm:grid-cols-3">
					{
						points.map((point) => (
							<div class="border-t border-ink/15 pt-3">
								<span class="flex h-8 w-8 items-center justify-center border border-ink/15 text-ink">
									<HugeIcon name={point.icon} class="h-4 w-4" />
								</span>
								<p class="mt-3 text-[12.5px] font-medium text-ink">{point.title}</p>
								<p class="mt-1 text-[11.5px] leading-[1.65] text-body">{point.copy}</p>
							</div>
						))
					}
				</div>

				<a href="#solutions" class="btn-outline mt-8 !min-h-[2.6rem] !px-4 !text-[11px]">
					Learn more
					<HugeIcon name="arrowRight" class="h-3.5 w-3.5" />
				</a>
			</div>
		</div>
	</div>
</section>
