---
import HugeIcon from "./HugeIcon.astro";

const tiers = [
	{
		capacity: "1 kW",
		amount: "₹30,000",
		tier: "Tier 01",
		copy: "A compact starting point for smaller homes and modest electricity use.",
		width: "38%",
		featured: false,
	},
	{
		capacity: "2 kW",
		amount: "₹60,000",
		tier: "Tier 02",
		copy: "A mid-sized system for everyday household loads and family routines.",
		width: "76%",
		featured: false,
	},
	{
		capacity: "3 kW & above",
		amount: "Up to ₹78,000",
		tier: "Tier 03",
		copy: "The maximum central support band for eligible residential installations.",
		width: "100%",
		featured: true,
	},
];
---

<section id="subsidy" class="relative overflow-hidden bg-cream py-20 sm:py-24 lg:py-28">
	<div class="pointer-events-none absolute -right-24 top-0 h-[420px] w-[420px] rounded-full border border-ink/[0.06]"></div>

	<div class="container-page relative">
		<div class="flex items-center justify-between gap-4 border-t border-ink/20 pt-4">
			<p class="meta text-ink/50">Incentives</p>
			<p class="meta text-ink/30">04 / PM Surya Ghar</p>
		</div>

		<div class="mt-12 flex flex-col gap-7 lg:flex-row lg:items-end lg:justify-between lg:gap-16">
			<h2 class="display max-w-[760px] text-[2.7rem] leading-[0.98] text-ink sm:text-[3.5rem] lg:text-[4.3rem]">
				Get up to <span class="text-yellow-deep">₹78,000</span> back on your rooftop.
			</h2>
			<div class="max-w-[340px]">
				<p class="text-[13.5px] leading-[1.8] text-body">
					Rooftop solar becomes more affordable with financial assistance under PM Surya Ghar:
					Muft Bijli Yojana. Eligible households receive support based on installed capacity.
				</p>
				<p class="meta mt-4 inline-flex items-center gap-2 border border-ink/20 px-2.5 py-1.5 text-ink/60">
					<HugeIcon name="building" class="h-3.5 w-3.5" />
					PM Surya Ghar
				</p>
			</div>
		</div>

		<div class="mt-12 grid gap-5 md:grid-cols-3 md:gap-0">
			{
				tiers.map((tier, index) => (
					<article
						class:list={[
							"reveal relative flex min-h-[330px] flex-col border-t border-ink/25 pt-5 md:px-7",
							index !== 0 && "md:border-l md:border-ink/15",
							tier.featured
								? "grain grain-dark mt-2 bg-navy p-6 text-white md:mt-0 md:border-t-0 md:pb-7 md:pt-6"
								: "pb-5",
						]}
						style={`transition-delay:${index * 70}ms`}
					>
						<div class="flex items-start justify-between gap-4">
							<span class:list={["meta", tier.featured ? "text-white/40" : "text-ink/45"]}>{tier.tier}</span>
							{tier.featured && (
								<span class="meta bg-yellow px-2 py-1 text-ink">Maximum</span>
							)}
						</div>

						<div class="mt-9">
							<p class:list={["meta", tier.featured ? "text-yellow" : "text-ink/45"]}>
								Indicative central subsidy
							</p>
							<p
								class:list={[
									"mt-2 font-display font-medium leading-none tracking-[-0.05em] tabular-nums",
									tier.featured ? "text-[2.4rem] text-white sm:text-[2.6rem]" : "text-[2.7rem] text-ink sm:text-[2.9rem]",
								]}
							>
								{tier.amount}
							</p>
							<p class:list={["mt-2 text-[11px]", tier.featured ? "text-white/40" : "text-muted"]}>
								For eligible residential installations
							</p>
						</div>

						<div class:list={["mt-auto pt-6", tier.featured ? "border-t border-white/15" : "border-t border-ink/15"]}>
							<div class="flex items-baseline justify-between gap-3">
								<p class:list={["text-[14px] font-medium", tier.featured ? "text-white/90" : "text-ink"]}>
									{tier.capacity}
								</p>
								<span class:list={["meta", tier.featured ? "text-white/35" : "text-ink/35"]}>System</span>
							</div>
							<p class:list={["mt-2 max-w-[260px] text-[12px] leading-[1.7]", tier.featured ? "text-white/55" : "text-body"]}>
								{tier.copy}
							</p>
							<div class:list={["mt-5 h-px w-full", tier.featured ? "bg-white/15" : "bg-ink/15"]}>
								<div
									class:list={["h-px", tier.featured ? "bg-yellow" : "bg-ink/50"]}
									style={`width:${tier.width}`}
								></div>
							</div>
						</div>
					</article>
				))
			}
		</div>

		<div class="mt-6 flex flex-col gap-5 border-t border-ink/20 pt-6 sm:flex-row sm:items-center sm:justify-between">
			<div class="flex items-start gap-3">
				<span class="grid h-9 w-9 shrink-0 place-items-center border border-ink/15 text-ink">
					<HugeIcon name="shield" class="h-4 w-4" />
				</span>
				<div>
					<p class="text-[13px] font-medium text-ink">We handle eligibility, application and documentation.</p>
					<p class="mt-1 max-w-[600px] text-[11.5px] leading-[1.7] text-body">
						Subsidy is subject to approval and current scheme guidelines; amounts are indicative.
					</p>
				</div>
			</div>
			<button type="button" class="btn-primary shrink-0 self-start sm:self-auto" data-open-lead-dialog>
				Check my eligibility
				<HugeIcon name="arrowRight" class="h-4 w-4" />
			</button>
		</div>

		<p class="mt-4 text-[10.5px] leading-5 text-muted">
			*Subsidy is subject to eligibility, approval and applicable scheme guidelines. Figures are
			indicative and may change.
		</p>
	</div>
</section>
