---
import HugeIcon from "./HugeIcon.astro";
import LeadForm from "./LeadForm.astro";
---

<section
	id="home"
	class="relative isolate flex min-h-[100svh] flex-col overflow-hidden bg-teal text-white"
	aria-labelledby="hero-heading"
>
	<img
		src="/images/hero-homes.webp"
		alt="A neighbourhood of homes with rooftop solar panels at dusk"
		width="2000"
		height="1200"
		fetchpriority="high"
		decoding="async"
		class="absolute inset-0 -z-30 h-full w-full object-cover object-[50%_68%] brightness-[1.06]"
	/>
	<div class="absolute inset-0 -z-20 bg-[#0c2e59]/45 mix-blend-multiply">
	</div>
	<div
		class="absolute inset-0 -z-20 bg-[linear-gradient(180deg,rgba(6,21,40,0.65)_0%,rgba(6,21,40,0.22)_38%,rgba(6,21,40,0.92)_100%)]"
	>
	</div>
	<div
		class="solar-grid-light pointer-events-none absolute inset-0 -z-10 opacity-[0.18]"
	>
	</div>
	<div class="grain grain-dark pointer-events-none absolute inset-0 -z-10">
	</div>

		<div
			class="container-page relative flex min-h-[100svh] flex-col pb-8 pt-24 sm:pb-8 sm:pt-28 lg:pt-32"
		>
			<div
				class="flex items-center justify-between gap-6 border-b border-white/15 pb-3"
			>
				<p class="meta text-white/55">Rooftop solar · Tamil Nadu</p>
				<p class="meta hidden text-white/35 sm:block">
					35+ MW installed · Since 2017
				</p>
				<p class="meta text-white/35 sm:hidden">Salem · India</p>
			</div>

				<div
					class="mt-8 grid flex-1 items-center gap-10 lg:mt-12 lg:grid-cols-12 lg:gap-12 xl:gap-16"
				>
					<div class="max-w-[620px] lg:col-span-7">
						<h1
							id="hero-heading"
							class="display text-[2.2rem] leading-[1.02] text-white sm:text-[2.85rem] lg:text-[3.3rem]"
						>
							Power your home with clean, renewable energy.
						</h1>
						<p
							class="mt-5 max-w-[460px] text-[14px] leading-[1.8] text-white/70 sm:text-[15.5px]"
						>
							Rooftop solar for Tamil Nadu homes — designed around
							your roof, your bill and your budget. Subsidy,
							paperwork and installation handled by one team.
						</p>

							<div class="mt-7 flex flex-wrap items-center gap-3">
								<a href="#estimate" class="btn-primary">
									Get a free estimate
									<HugeIcon
										name="arrowRight"
										class="h-4 w-4"
									/>
								</a>
								<a
									href="#solutions"
									class="btn-glass hidden sm:inline-flex"
								>
									Explore solar
									<HugeIcon
										name="arrowDown"
										class="h-3.5 w-3.5"
									/>
								</a>
							</div>

							<div
								class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 border-t border-white/15 pt-5 text-[11px] uppercase tracking-[0.14em] text-white/60"
							>
								<span class="flex items-center gap-2">
									<span
										class="h-1.5 w-1.5 rounded-full bg-yellow"
										aria-hidden="true"></span>
									PM Surya Ghar · Up to ₹78,000*
								</span>
								<span class="flex items-center gap-2">
									<span
										class="h-1.5 w-1.5 rounded-full bg-green"
										aria-hidden="true"></span>
									Salem Field Office
								</span>
							</div>
						</div>

						<div class="lg:col-span-5">
							<div
								class="relative border border-white/20 bg-paper p-5 sm:p-7 text-ink shadow-[0_30px_90px_-20px_rgba(0,0,0,0.7)] backdrop-blur-md"
							>
								<div
									class="flex items-center justify-between gap-3 border-b border-ink/10 pb-3"
								>
									<div>
										<p
											class="meta text-orange-deep font-semibold"
										>
											Free Solar Assessment
										</p>
										<h2
											class="display mt-1 text-[1.4rem] sm:text-[1.55rem] leading-[1.1] text-ink"
										>
											Get your estimate
										</h2>
									</div>
									<span
										class="meta border border-green/30 bg-green-soft px-2.5 py-1 text-green font-medium"
									>
										Salem, TN
									</span>
								</div>
								<p
									class="mt-2 text-[12px] leading-[1.6] text-body"
								>
									Share 4 details to see your roof suitability
									and eligible government subsidy.
								</p>

								<div class="mt-4">
									<LeadForm
										idPrefix="hero"
										source="hero-section"
										buttonLabel="Explore my solar potential"
									/>
								</div>
							</div>
						</div>
					</div>

						<div class="mt-12 pt-6">
							<div
								class="hidden flex-wrap items-center justify-between gap-3 border-t border-white/15 pt-3 sm:flex"
							>
								<p class="meta text-white/45">
									Rooftop · Commercial · Utility
								</p>
								<a
									href="#stats"
									class="group inline-flex items-center gap-2 text-[10.5px] uppercase tracking-[0.14em] text-white/55 transition-colors hover:text-white"
								>
									Scroll to explore
									<span
										class="grid h-7 w-7 place-items-center border border-white/25 transition-colors group-hover:border-yellow group-hover:text-yellow"
									>
										<HugeIcon
											name="arrowDown"
											class="h-3.5 w-3.5"
										/>
									</span>
								</a>
							</div>

							<p
								class="mt-2 select-none font-display text-[clamp(6rem,16vw,18rem)] font-semibold leading-[0.85] tracking-[-0.065em] text-white/90"
								aria-hidden="true"
							>
								NIRT
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
