---
import LeadForm from "./LeadForm.astro";
import HugeIcon from "./HugeIcon.astro";

const benefits = [
	{ label: "Loan assistance", icon: "handCoins" as const },
	{ label: "End-to-end support", icon: "taskDone" as const },
	{ label: "Subsidy guidance", icon: "badgeCheck" as const },
];
---

<section
	id="home"
	class="relative isolate overflow-hidden bg-[linear-gradient(180deg,#f7fbff_0%,#f2f8f6_100%)]"
	aria-labelledby="hero-heading"
>
	<div class="pointer-events-none absolute inset-0 -z-20 overflow-hidden">
		<div class="absolute -left-40 -top-48 h-[560px] w-[560px] rounded-none bg-green/[0.09] blur-3xl"></div>
		<div class="absolute -right-40 top-10 h-[520px] w-[520px] rounded-none bg-orange/[0.1] blur-3xl"></div>
		<div class="absolute bottom-0 left-1/3 h-[360px] w-[520px] rounded-none bg-navy/[0.07] blur-3xl"></div>
	</div>
	<div
		class="solar-grid pointer-events-none absolute inset-y-0 left-0 -z-10 w-[62%] opacity-60 [mask-image:linear-gradient(90deg,black,transparent_88%)]"
	></div>
	<div
		class="pointer-events-none absolute -right-24 top-24 -z-10 hidden h-[430px] w-[430px] rounded-none border border-navy/10 lg:block"
	></div>
	<div
		class="pointer-events-none absolute right-10 top-52 -z-10 hidden h-[250px] w-[250px] rounded-none border border-dashed border-green/20 lg:block"
	></div>

	<div class="container-page relative py-10 sm:py-12 lg:py-14 xl:py-16">
		<div class="grid items-center gap-10 lg:grid-cols-[1.04fr_0.96fr] lg:gap-10 xl:gap-16">
			<div class="max-w-[640px]">
				<a
					href="#subsidy"
					class="group inline-flex items-center gap-2.5 rounded-none border border-navy/10 bg-white/90 py-1.5 pl-2.5 pr-3.5 text-[8.5px] font-semibold uppercase tracking-[0.13em] text-navy shadow-[0_10px_26px_-20px_rgba(11,31,58,0.5)] backdrop-blur transition-colors hover:border-green/30 sm:text-[9px]"
				>
					<span class="flex h-5 w-5 items-center justify-center rounded-none bg-green-soft text-green">
						<HugeIcon name="sun" class="h-3 w-3" />
					</span>
					PM Surya Ghar · Residential solar
					<HugeIcon
						name="arrowUpRight"
						class="h-3 w-3 text-moss transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-green"
					/>
				</a>

				<h1
					id="hero-heading"
					class="display mt-6 text-[3.35rem] leading-[0.94] text-navy sm:text-[4.4rem] lg:text-[4.9rem] xl:text-[5.5rem]"
				>
					The sun
					<span class="relative mt-1 block w-fit text-green">
						pays back.
						<svg
							class="absolute -bottom-2 left-0 h-3 w-full text-orange sm:-bottom-3"
							viewBox="0 0 320 18"
							fill="none"
							preserveAspectRatio="none"
							aria-hidden="true"
						>
							<path
								d="M3 13.5C74 5.5 198 3.5 317 8.5"
								stroke="currentColor"
								stroke-width="5"
								stroke-linecap="round"
							></path>
						</svg>
					</span>
				</h1>

				<p class="mt-7 max-w-[500px] text-[13px] leading-[1.85] text-body sm:text-[14.5px]">
					Rooftop solar for Tamil Nadu homes — designed around your roof, your bill and your
					budget. We handle the paperwork, the subsidy and the installation.
				</p>

				<div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
					<div class="flex items-baseline gap-2.5">
						<span class="stat-number font-sans text-[1.9rem] text-navy">₹78,000</span>
						<span class="max-w-[95px] text-[8px] font-semibold uppercase leading-[1.45] tracking-[0.11em] text-moss">
							Up to central subsidy*
						</span>
					</div>
					<span class="hidden h-8 w-px bg-navy/12 sm:block"></span>
					<div class="flex items-baseline gap-2.5">
						<span class="stat-number text-[1.5rem] text-green">35+ MW</span>
						<span class="max-w-[85px] text-[8px] font-semibold uppercase leading-[1.45] tracking-[0.11em] text-moss">
							Solar portfolio
						</span>
					</div>
				</div>

				<div class="mt-7 flex flex-wrap items-center gap-3">
					<a href="#estimate" class="btn-primary">
						Get my free estimate
						<HugeIcon name="arrowRight" class="h-4 w-4" />
					</a>
					<a href="#why-solar" class="btn-outline group">
						<span class="flex h-5 w-5 items-center justify-center rounded-none bg-navy-tint text-navy">
							<HugeIcon name="play" class="h-2.5 w-2.5" />
						</span>
						See how solar works
					</a>
				</div>

				<ul class="mt-7 flex flex-wrap gap-x-5 gap-y-2.5">
					{
						benefits.map((benefit) => (
							<li class="flex items-center gap-1.5 text-[9.5px] font-medium text-body">
								<span class="flex h-4 w-4 items-center justify-center rounded-none bg-green-soft text-green">
									<HugeIcon name={benefit.icon} class="h-2.5 w-2.5" />
								</span>
								{benefit.label}
							</li>
						))
					}
				</ul>

				<div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-navy/10 pt-4 text-[8px] font-semibold uppercase tracking-[0.14em] text-moss">
					<span class="flex items-center gap-1.5">
						<HugeIcon name="shieldCheck" class="h-3 w-3 text-green" />
						MNRE / TEDA experience
					</span>
					<span class="flex items-center gap-1.5">
						<HugeIcon name="mapPin" class="h-3 w-3 text-orange" />
						Salem, Tamil Nadu
					</span>
					<span class="flex items-center gap-1.5">
						<HugeIcon name="clock" class="h-3 w-3 text-navy" />
						Since 2017
					</span>
				</div>
			</div>

			<div id="estimate" class="relative w-full max-w-[480px] justify-self-center lg:justify-self-end">
				<div class="pointer-events-none absolute -right-6 -top-8 hidden h-24 w-24 rounded-none border border-dashed border-orange/30 sm:block"></div>

				<div
					class="relative overflow-hidden rounded-none border border-white bg-white p-2 shadow-[0_44px_100px_-44px_rgba(11,31,58,0.48)]"
				>
					<div class="relative h-[144px] overflow-hidden rounded-none sm:h-[158px]">
						<img
							src="/images/hero-homes.webp"
							alt="Homes with rooftop solar panels in Tamil Nadu"
							width="2000"
							height="1200"
							fetchpriority="high"
							decoding="async"
							class="h-full w-full object-cover object-[62%_62%]"
						/>
						<div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(7,27,60,0.55)_0%,rgba(7,27,60,0.06)_42%,rgba(7,27,60,0.78)_100%)]"></div>
						<div
							class="absolute left-3 top-3 inline-flex items-center gap-1.5 rounded-none border border-white/25 bg-white/15 px-2.5 py-1.5 text-[7.5px] font-semibold uppercase tracking-[0.12em] text-white backdrop-blur-md"
						>
							<HugeIcon name="mapPin" class="h-2.5 w-2.5 text-green-mid" />
							Salem · Tamil Nadu
						</div>
						<div class="absolute inset-x-3 bottom-3 flex items-end justify-between gap-3">
							<div>
								<p class="text-[7.5px] font-semibold uppercase tracking-[0.16em] text-green-mid">
									Your rooftop, reimagined
								</p>
								<p class="display mt-1 text-[1.25rem] leading-[1.05] text-white">
									Clean power. Clear numbers.
								</p>
							</div>
							<span class="hidden shrink-0 items-center gap-1 rounded-none border border-white/20 bg-white/15 px-2.5 py-1.5 text-[7px] font-semibold uppercase tracking-[0.1em] text-white backdrop-blur-md sm:inline-flex">
								<HugeIcon name="solarPanel" class="h-3 w-3 text-orange" />
								25-year life
							</span>
						</div>
					</div>

					<div class="px-4 pb-4 pt-5 sm:px-5">
						<div class="flex items-start justify-between gap-3">
							<div>
								<p class="eyebrow text-green">Free assessment</p>
								<h2 class="display mt-2 text-[1.5rem] leading-[1.02] text-navy sm:text-[1.65rem]">
									Get your solar estimate.
								</h2>
							</div>
							<span class="chip chip-green shrink-0 whitespace-nowrap">
								<HugeIcon name="clock" class="h-2.5 w-2.5" />
								1 min
							</span>
						</div>
						<p class="mt-2 max-w-[340px] text-[10.5px] leading-[1.65] text-body">
							Four quick details and a Salem specialist will call you with a clear next
							step.
						</p>

						<div class="mt-4">
							<LeadForm idPrefix="hero" source="hero" buttonLabel="Get My Solar Estimate" />
						</div>
					</div>
				</div>

				<p class="mt-3 flex items-center justify-center gap-1.5 text-[8px] text-moss lg:justify-end">
					<HugeIcon name="shieldCheck" class="h-2.5 w-2.5 text-green" />
					No obligation. Your details stay private.
				</p>
			</div>
		</div>
	</div>
</section>
