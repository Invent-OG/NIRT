---
import LeadForm from "./LeadForm.astro";

const benefits = ["Loan assistance", "End-to-end project support", "PM Surya Ghar guidance"];
---

<section id="home" class="relative isolate overflow-hidden bg-ink text-paper" aria-labelledby="hero-heading">
	<img
		src="/images/hero-homes.webp"
		alt=""
		width="2000"
		height="1200"
		fetchpriority="high"
		decoding="async"
		class="absolute inset-0 -z-30 h-full w-full object-cover object-[68%_58%] opacity-80"
	/>
	<div class="absolute inset-0 -z-20 bg-[linear-gradient(90deg,#061a15_0%,rgba(6,26,21,0.94)_30%,rgba(6,26,21,0.62)_58%,rgba(6,26,21,0.2)_100%)]"></div>
	<div class="absolute inset-0 -z-20 bg-[linear-gradient(0deg,rgba(6,26,21,0.9)_0%,rgba(6,26,21,0)_45%)]"></div>
	<div class="aurora -z-10 opacity-45"></div>
	<div class="solar-grid-light pointer-events-none absolute inset-0 -z-10 opacity-25 [mask-image:linear-gradient(90deg,black,transparent_72%)]"></div>
	<div class="pointer-events-none absolute inset-y-0 left-[6%] -z-10 w-px bg-white/[0.06]"></div>
	<div class="pointer-events-none absolute inset-y-0 right-[6%] -z-10 w-px bg-white/[0.04]"></div>

	<div class="container-page relative py-12 sm:py-14 lg:py-16 xl:py-20">
		<div class="grid items-center gap-12 lg:grid-cols-[1.06fr_0.94fr] lg:gap-10 xl:gap-16">
			<div class="max-w-[650px]">
				<p class="inline-flex items-center gap-2.5 rounded-full border border-white/15 bg-white/[0.055] px-3.5 py-2 text-[9px] font-medium uppercase tracking-[0.17em] text-white/70 backdrop-blur-md sm:text-[9.5px]">
					<span class="relative flex h-1.5 w-1.5">
						<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-solar opacity-60"></span>
						<span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-solar"></span>
					</span>
					PM Surya Ghar · Residential solar
					<span class="ml-1 text-[10px] text-solar" aria-hidden="true">✦</span>
				</p>

				<h1
					id="hero-heading"
					class="display mt-7 text-[3.6rem] leading-[0.92] text-paper sm:text-[4.5rem] lg:text-[5.1rem] xl:text-[5.9rem]"
				>
					The sun
					<span class="block">pays <em class="text-solar">back.</em></span>
				</h1>

				<div class="mt-5 flex items-end gap-3.5 sm:gap-4">
					<span class="font-sans text-[2.35rem] font-semibold leading-none tracking-[-0.055em] text-[#f8dda8] tabular-nums sm:text-[2.8rem]">
						₹78,000
					</span>
					<p class="mb-1 max-w-[145px] text-[8px] font-semibold uppercase leading-[1.55] tracking-[0.15em] text-white/50 sm:text-[8.5px]">
						Up to central subsidy for eligible homes*
					</p>
				</div>

				<p class="mt-6 max-w-[490px] text-[13.5px] leading-[1.9] text-white/65 sm:text-[14.5px]">
					Rooftop solar for Tamil Nadu homes — designed around your roof, your bill and your
					budget. We handle the paperwork, the subsidy and the installation.
				</p>

				<ul class="mt-7 flex flex-wrap gap-2">
					{
						benefits.map((benefit) => (
							<li class="inline-flex items-center gap-2 rounded-full border border-white/12 bg-white/[0.055] px-3 py-1.5 text-[10px] font-medium text-white/75 backdrop-blur-md">
								<svg class="h-3 w-3 text-solar" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
									<path d="m2.5 6 2.2 2.2L9.5 3.5" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
								{benefit}
							</li>
						))
					}
				</ul>

				<div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
					<a href="#estimate" class="btn-solar">
						Plan my rooftop
						<span class="text-[12px] leading-none opacity-75" aria-hidden="true">✦</span>
					</a>
					<a
						href="#why-solar"
						class="group inline-flex items-center gap-2 text-[10.5px] font-medium text-white/60 transition-colors hover:text-white"
					>
						See the numbers first
						<svg class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-y-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
							<path d="M8 3v10M4.5 9.5 8 13l3.5-3.5" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</a>
				</div>

				<div class="mt-9 flex flex-wrap items-center gap-x-5 gap-y-2 text-[9px] uppercase tracking-[0.14em] text-white/35">
					<span class="flex items-center gap-2">
						<span class="h-1 w-1 rounded-full bg-solar" aria-hidden="true"></span>
						35+ MW portfolio
					</span>
					<span class="flex items-center gap-2">
						<span class="h-1 w-1 rounded-full bg-solar" aria-hidden="true"></span>
						Since 2017
					</span>
					<span class="flex items-center gap-2">
						<span class="h-1 w-1 rounded-full bg-solar" aria-hidden="true"></span>
						Salem, Tamil Nadu
					</span>
				</div>
			</div>

			<div id="estimate" class="w-full lg:justify-self-end">
				<div class="edge-gold relative w-full max-w-[470px] rounded-[30px] p-[5px] shadow-[0_40px_100px_-30px_rgba(0,0,0,0.65)] sm:p-[6px] lg:ml-auto">
					<div class="grain relative overflow-hidden rounded-[25px] bg-paper p-5 text-ink sm:p-6">
						<div class="pointer-events-none absolute -right-16 -top-20 h-40 w-40 rounded-full bg-solar/20 blur-3xl"></div>
						<div class="relative z-[2]">
							<div class="flex items-start justify-between gap-3">
								<span class="inline-flex items-center gap-1.5 rounded-full border border-forest/15 bg-mint px-2.5 py-1 text-[8px] font-semibold uppercase tracking-[0.14em] text-forest">
									<span class="h-1 w-1 rounded-full bg-forest" aria-hidden="true"></span>
									Complimentary
								</span>
								<span class="flex items-center gap-1.5 text-[9px] text-moss">
									<svg class="h-3 w-3" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
										<circle cx="8" cy="8" r="6" />
										<path d="M8 4.5V8l2.2 1.4" stroke-linecap="round" />
									</svg>
									Under a minute
								</span>
							</div>

							<h2 class="display mt-4 text-[1.75rem] leading-[1.02] text-ink sm:text-[1.95rem]">
								Tell us about your <em class="text-forest">roof.</em>
							</h2>
							<p class="mt-2 max-w-[330px] text-[11px] leading-[1.7] text-body">
								A specialist from our Salem team will call you with a clear next step — no
								obligation.
							</p>

							<div class="my-4 flex items-center gap-3">
								<div class="h-px flex-1 bg-ink/10"></div>
								<span class="text-[8px] uppercase tracking-[0.18em] text-moss/70">Free assessment</span>
								<div class="h-px flex-1 bg-ink/10"></div>
							</div>

							<LeadForm idPrefix="hero" source="hero" buttonLabel="Get My Solar Estimate" />
						</div>
					</div>
				</div>

				<p class="mt-3 text-center text-[8.5px] leading-4 text-white/35 lg:text-right">
					*Central subsidy subject to eligibility and current scheme guidelines.
				</p>
			</div>
		</div>
	</div>
</section>
