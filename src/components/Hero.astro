---
import HugeIcon from "./HugeIcon.astro";
---

<section
	id="home"
	class="relative isolate flex min-h-[100svh] flex-col overflow-hidden bg-teal text-white"
	aria-labelledby="hero-heading"
>
	<img
		src="/images/hero-homes.webp"
		alt="A neighbourhood of homes with rooftop solar panels at dusk"
		width="2000"
		height="1200"
		fetchpriority="high"
		decoding="async"
		class="absolute inset-0 -z-30 h-full w-full object-cover object-[50%_68%] brightness-[1.06]"
	/>
	<div class="absolute inset-0 -z-20 bg-[#073743]/42 mix-blend-multiply"></div>
	<div
		class="absolute inset-0 -z-20 bg-[linear-gradient(180deg,rgba(6,30,38,0.58)_0%,rgba(6,30,38,0.12)_38%,rgba(6,30,38,0.88)_100%)]"
	></div>
	<div class="solar-grid-light pointer-events-none absolute inset-0 -z-10 opacity-[0.18]"></div>
	<div class="grain grain-dark pointer-events-none absolute inset-0 -z-10"></div>

	<div class="container-page relative flex min-h-[100svh] flex-col pb-8 pt-20 sm:pb-5 sm:pt-28">
		<div class="flex items-center justify-between gap-6 border-b border-white/15 pb-3">
			<p class="meta text-white/55">Rooftop solar · Tamil Nadu</p>
			<p class="meta hidden text-white/35 sm:block">35+ MW installed · Since 2017</p>
			<p class="meta text-white/35 sm:hidden">Salem · India</p>
		</div>

		<div class="mt-6 max-w-[560px] sm:mt-10 lg:mt-12">
			<h1
				id="hero-heading"
				class="display text-[2.15rem] leading-[1.02] text-white sm:text-[2.7rem] lg:text-[3.1rem]"
			>
				Power your home with clean, renewable energy.
			</h1>
			<p class="mt-5 max-w-[420px] text-[14px] leading-[1.8] text-white/65 sm:text-[15px]">
				Rooftop solar for Tamil Nadu homes — designed around your roof, your bill and your
				budget. Subsidy, paperwork and installation handled by one team.
			</p>

			<div class="mt-7 flex flex-wrap items-center gap-3">
				<a href="#estimate" class="btn-primary">
					Get a free estimate
					<HugeIcon name="arrowRight" class="h-4 w-4" />
				</a>
				<a href="#solutions" class="btn-glass hidden sm:inline-flex">
					Explore solar
					<HugeIcon name="arrowDown" class="h-3.5 w-3.5" />
				</a>
			</div>

			<p class="mt-5 flex items-center gap-2 text-[11px] uppercase tracking-[0.14em] text-white/45">
				<span class="h-1 w-1 rounded-full bg-yellow" aria-hidden="true"></span>
				PM Surya Ghar guidance · Up to ₹78,000*
			</p>
		</div>

		<div class="mt-auto pt-6">
			<div class="hidden flex-wrap items-center justify-between gap-3 border-t border-white/15 pt-3 sm:flex">
				<p class="meta text-white/45">Rooftop · Commercial · Utility</p>
				<a href="#stats" class="group inline-flex items-center gap-2 text-[10.5px] uppercase tracking-[0.14em] text-white/55 transition-colors hover:text-white">
					Scroll to explore
					<span class="grid h-7 w-7 place-items-center border border-white/25 transition-colors group-hover:border-yellow group-hover:text-yellow">
						<HugeIcon name="arrowDown" class="h-3.5 w-3.5" />
					</span>
				</a>
			</div>

			<p
				class="mt-2 select-none font-display text-[clamp(7rem,18vw,20rem)] font-semibold leading-[0.85] tracking-[-0.065em] text-white"
				aria-hidden="true"
			>
				NIRT
			</p>
		</div>
	</div>
</section>
