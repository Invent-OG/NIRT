---
import HugeIcon from "./HugeIcon.astro";

const faqs = [
	{
		question: "What size system does my home need?",
		answer: "It depends on your consumption, roof area and how much of your bill you want to offset. A 1–3 kW system suits many Tamil Nadu homes, but we size it from your bill and a site assessment rather than a rule of thumb. The estimate is free.",
	},
	{
		question: "How much subsidy can I get under PM Surya Ghar?",
		answer: "Eligible residential systems can receive central support of up to ₹1,00,000, depending on installed capacity and current scheme guidelines. NIRT handles the application and documentation; approval rests with the scheme authorities. Amounts are indicative.",
	},
	{
		question: "How long does the whole process take?",
		answer: "A site assessment and written proposal typically take a few days. Installation and commissioning depend on approvals, DISCOM processes and site readiness. We give you a written schedule before work starts.",
	},
	{
		question: "Will my roof work for solar?",
		answer: "Most concrete and metal roofs do. Shading, structural condition and usable area all matter. The site assessment checks each of these, and we'll tell you honestly if solar is not the right fit for your roof.",
	},
	{
		question: "What happens after installation?",
		answer: "We hand over the documentation, warranty details and system operation guidance. Monitoring, maintenance and performance checks are available after commissioning, across Tamil Nadu.",
	},
	{
		question: "Can I pay in instalments?",
		answer: "Yes, through eligible bank or lender financing, subject to credit assessment and approval. NIRT does not lend directly. Use the EMI calculator above to see an illustrative monthly number before you decide.",
	},
];
---

<section
	id="faq"
	class="relative overflow-hidden bg-paper py-20 sm:py-24 lg:py-28"
>
	<div class="container-page">
		<div
			class="flex items-center justify-between gap-4 border-t border-ink/15 pt-4"
		>
			<p class="meta text-ink/50">Before you commit</p>
			<p class="meta text-ink/30">09 / FAQ</p>
		</div>

		<div class="mt-12 grid gap-12 lg:grid-cols-[0.78fr_1.22fr] lg:gap-16">
			<div class="reveal lg:sticky lg:top-28 lg:self-start">
				<h2
					class="display text-[2.6rem] leading-[0.98] text-ink sm:text-[3.2rem] lg:text-[3.7rem]"
				>
					Questions, answered early.
				</h2>
				<p
					class="mt-5 max-w-[350px] text-[13.5px] leading-[1.8] text-body"
				>
					The things homeowners ask us most, before anyone signs
					anything. If yours isn't here, call and ask.
				</p>

				<div
					class="mt-8 rounded-2xl border border-ink/15 p-5 bg-[#fffdf7]"
				>
					<p class="meta text-ink/40">Talk to a person</p>
					<p class="mt-2 text-[14px] font-medium text-ink">
						Still deciding? That's fine.
					</p>
					<p class="mt-1 text-[12px] leading-[1.65] text-body">
						A short call is often faster than a form.
					</p>
					<div class="mt-4 flex flex-col gap-2 sm:flex-row">
						<a
							href="tel:+919655046464"
							class="btn-primary !min-h-[2.5rem] !px-4 !text-[11px]"
						>
							<HugeIcon name="phone" class="h-3.5 w-3.5" />
							Call us
						</a>
						<a
							href="https://wa.me/919655046464"
							class="btn-outline !min-h-[2.5rem] !px-4 !text-[11px]"
						>
							<HugeIcon
								name="whatsapp"
								class="h-3.5 w-3.5 text-green"
							/>
							WhatsApp
						</a>
					</div>
				</div>
			</div>

			<div
				class="reveal border-t border-ink/20"
				style="transition-delay:100ms"
			>
				{
					faqs.map((faq, index) => (
						<details
							class="group border-b border-ink/20"
							open={index === 0}
						>
							<summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 text-[15px] font-medium leading-[1.45] text-ink transition-colors hover:text-green-deep">
								<span>{faq.question}</span>
								<span class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full border border-ink/20 text-ink transition-colors duration-300 group-open:border-yellow group-open:bg-yellow">
									<HugeIcon
										name="plus"
										class="h-3 w-3 transition-transform duration-300 group-open:rotate-45"
									/>
								</span>
							</summary>
							<p class="max-w-[620px] pb-6 pr-10 text-[13px] leading-[1.75] text-body">
								{faq.answer}
							</p>
						</details>
					))
				}
				<p class="mt-5 text-[10.5px] leading-5 text-muted">
					Subsidy, generation and financing figures on this page are
					indicative. Confirm current scheme and lender terms before
					you commit.
				</p>
			</div>
		</div>
	</div>
</section>
