---
import Logo from "./Logo.astro";

const navItems = [
	{ label: "Why Solar", href: "#why-solar", number: "01" },
	{ label: "Subsidy", href: "#subsidy", number: "02" },
	{ label: "Projects", href: "#projects", number: "03" },
	{ label: "Payment Options", href: "#payment", number: "04" },
	{ label: "Process", href: "#process", number: "05" },
	{ label: "Reviews", href: "#reviews", number: "06" },
];
---

<div class="relative z-50 bg-ink text-[#fbf8f1]">
	<div class="container-page flex h-8 items-center justify-between gap-6 text-[8.5px] font-medium uppercase tracking-[0.18em] text-white/55 sm:text-[9px]">
		<p class="flex min-w-0 items-center gap-2">
			<span class="text-solar" aria-hidden="true">✦</span>
			<span class="truncate">Solar, made simple. Since 2017.</span>
		</p>
		<div class="flex shrink-0 items-center gap-5">
			<span class="hidden text-white/35 md:inline">MNRE / TEDA experience</span>
			<a
				href="tel:+919655046464"
				class="normal-case tracking-[0.06em] text-white/75 transition-colors hover:text-solar"
			>
				+91 96550 46464
			</a>
		</div>
	</div>
</div>

<header
	class="sticky top-0 z-50 border-b border-ink/10 bg-paper/85 backdrop-blur-xl transition-shadow duration-300"
	data-site-header
>
	<div class="container-page flex h-[76px] items-center justify-between gap-4">
		<Logo class="shrink-0" />

		<nav class="hidden items-center gap-6 xl:flex 2xl:gap-8" aria-label="Main navigation">
			{
				navItems.map((item) => (
					<a
						href={item.href}
						class="group relative py-2 text-[11.5px] font-medium text-body transition-colors hover:text-ink"
					>
						{item.label}
						<span
							class="absolute -bottom-0.5 left-1/2 h-1 w-1 -translate-x-1/2 rounded-full bg-solar opacity-0 transition-opacity duration-200 group-hover:opacity-100"
							aria-hidden="true"
						></span>
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-2.5">
			<a
				href="tel:+919655046464"
				class="hidden items-center gap-1.5 text-[10.5px] font-medium text-body transition-colors hover:text-ink 2xl:inline-flex"
			>
				<span class="h-1.5 w-1.5 rounded-full bg-forest" aria-hidden="true"></span>
				Talk to us
			</a>
			<a
				href="#estimate"
				class="btn-solar hidden !min-h-[2.65rem] !px-5 !text-[10.5px] sm:inline-flex"
			>
				Get My Estimate
				<span class="text-[12px] leading-none opacity-75" aria-hidden="true">✦</span>
			</a>

			<button
				type="button"
				class="flex h-10 w-10 items-center justify-center rounded-full border border-ink/15 bg-white/40 text-ink transition-colors hover:bg-cream xl:hidden"
				aria-label="Open menu"
				aria-expanded="false"
				aria-controls="mobile-menu"
				data-menu-toggle
			>
				<svg class="h-5 w-5" data-menu-icon-open viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
					<path d="M4 8h16M4 16h16" stroke-linecap="round" />
				</svg>
				<svg class="hidden h-5 w-5" data-menu-icon-close viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
					<path d="m6 6 12 12M18 6 6 18" stroke-linecap="round" />
				</svg>
			</button>
		</div>
	</div>

	<div id="mobile-menu" class="hidden border-t border-ink/10 bg-paper/97 backdrop-blur-2xl xl:hidden" data-mobile-menu>
		<nav class="container-page py-6 sm:py-8" aria-label="Mobile navigation">
			<p class="eyebrow text-forest">Explore NIRT</p>
			<ul class="mt-4 divide-y divide-ink/10 border-y border-ink/10">
				{
					navItems.map((item) => (
						<li>
							<a
								href={item.href}
								class="group flex items-center justify-between gap-4 py-3.5 text-[15px] font-medium text-ink transition-colors hover:text-forest"
							>
								<span class="flex items-baseline gap-3">
									<span class="text-[8.5px] font-semibold tracking-[0.16em] text-solar-deep">{item.number}</span>
									{item.label}
								</span>
								<svg class="h-4 w-4 text-moss transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
									<path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</a>
						</li>
					))
				}
			</ul>
			<div class="mt-5 grid gap-2 sm:grid-cols-2">
				<a href="#estimate" class="btn-solar w-full">
					Get My Solar Estimate
					<span class="text-[12px] leading-none opacity-75" aria-hidden="true">✦</span>
				</a>
				<a href="tel:+919655046464" class="btn-outline w-full">
					Call +91 96550 46464
				</a>
			</div>
			<p class="mt-4 text-[9px] uppercase tracking-[0.16em] text-moss">
				Salem, Tamil Nadu · Serving homes and businesses across the state
			</p>
		</nav>
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>("[data-site-header]");
	const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
	const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
	const iconOpen = document.querySelector<SVGElement>("[data-menu-icon-open]");
	const iconClose = document.querySelector<SVGElement>("[data-menu-icon-close]");

	if (header) {
		const updateHeader = () => {
			header.classList.toggle("shadow-[0_18px_50px_-30px_rgba(8,31,27,0.45)]", window.scrollY > 10);
		};
		updateHeader();
		window.addEventListener("scroll", updateHeader, { passive: true });
	}

	if (toggle && menu) {
		const setOpen = (open: boolean) => {
			menu.classList.toggle("hidden", !open);
			toggle.setAttribute("aria-expanded", String(open));
			toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
			iconOpen?.classList.toggle("hidden", open);
			iconClose?.classList.toggle("hidden", !open);
		};

		toggle.addEventListener("click", () => setOpen(menu.classList.contains("hidden")));
		menu.querySelectorAll("a").forEach((link) => {
			link.addEventListener("click", () => setOpen(false));
		});

		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape") setOpen(false);
		});

		window.addEventListener("resize", () => {
			if (window.innerWidth >= 1280) setOpen(false);
		});
	}
</script>
