---
import Logo from "./Logo.astro";
import HugeIcon from "./HugeIcon.astro";

const navItems = [
	{ label: "Why Solar", href: "#why-solar", number: "01" },
	{ label: "Subsidy", href: "#subsidy", number: "02" },
	{ label: "Projects", href: "#projects", number: "03" },
	{ label: "Payment Options", href: "#payment", number: "04" },
	{ label: "Process", href: "#process", number: "05" },
	{ label: "Reviews", href: "#reviews", number: "06" },
];
---

<div class="relative z-50 bg-navy-dark text-white">
	<div
		class="container-page flex h-9 items-center justify-between gap-6 text-[8.5px] font-medium tracking-[0.12em] text-white/60 sm:text-[9px]"
	>
		<p class="flex min-w-0 items-center gap-2.5">
			<span class="relative flex h-1.5 w-1.5 shrink-0">
				<span class="absolute inline-flex h-full w-full animate-ping rounded-none bg-green opacity-70"></span>
				<span class="relative inline-flex h-1.5 w-1.5 rounded-none bg-green"></span>
			</span>
			<span class="truncate uppercase">Powering Tamil Nadu with sunshine · Since 2017</span>
		</p>
		<div class="flex shrink-0 items-center gap-5">
			<span class="hidden items-center gap-1.5 text-white/45 md:inline-flex">
				<HugeIcon name="shieldCheck" class="h-3 w-3 text-green" />
				MNRE / TEDA experience
			</span>
			<a
				href="tel:+919655046464"
				class="inline-flex items-center gap-1.5 normal-case tracking-[0.04em] text-white/80 transition-colors hover:text-orange"
			>
				<HugeIcon name="phone" class="h-3 w-3 text-orange" />
				+91 96550 46464
			</a>
		</div>
	</div>
</div>

<header
	class="sticky top-0 z-50 border-b border-line/80 bg-white/90 backdrop-blur-xl transition-shadow duration-300"
	data-site-header
>
	<div class="container-page flex h-[78px] items-center justify-between gap-4">
		<Logo class="shrink-0" />

		<nav class="hidden items-center gap-6 xl:flex 2xl:gap-7" aria-label="Main navigation">
			{
				navItems.map((item) => (
					<a
						href={item.href}
						class="group relative py-2 text-[11px] font-medium text-body transition-colors hover:text-navy"
					>
						{item.label}
						<span
							class="absolute -bottom-0.5 left-1/2 h-1 w-1 -translate-x-1/2 rounded-none bg-orange opacity-0 transition-opacity duration-200 group-hover:opacity-100"
							aria-hidden="true"
						></span>
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-2.5">
			<a
				href="tel:+919655046464"
				class="hidden items-center gap-2.5 pr-1 2xl:inline-flex"
			>
				<span class="icon-tile icon-tile-green h-8 w-8 rounded-none">
					<HugeIcon name="phone" class="h-3.5 w-3.5" />
				</span>
				<span class="leading-tight">
					<span class="block text-[7px] font-semibold uppercase tracking-[0.16em] text-moss">Talk to us</span>
					<span class="block text-[10.5px] font-semibold text-navy">+91 96550 46464</span>
				</span>
			</a>
			<a href="#estimate" class="btn-primary hidden !min-h-[2.7rem] !px-4 !text-[10.5px] sm:inline-flex">
				Get Free Estimate
				<HugeIcon name="arrowUpRight" class="h-3.5 w-3.5" />
			</a>

			<button
				type="button"
				class="flex h-10 w-10 items-center justify-center rounded-none border border-navy/15 bg-cloud text-navy transition-colors hover:bg-navy-tint xl:hidden"
				aria-label="Open menu"
				aria-expanded="false"
				aria-controls="mobile-menu"
				data-menu-toggle
			>
				<span data-menu-icon-open>
					<HugeIcon name="menu" class="h-5 w-5" />
				</span>
				<span class="hidden" data-menu-icon-close>
					<HugeIcon name="close" class="h-5 w-5" />
				</span>
			</button>
		</div>
	</div>

	<div id="mobile-menu" class="hidden border-t border-line bg-white xl:hidden" data-mobile-menu>
		<nav class="container-page py-6 sm:py-8" aria-label="Mobile navigation">
			<div class="flex items-center justify-between gap-4">
				<p class="eyebrow text-green">Explore NIRT</p>
				<a href="tel:+919655046464" class="inline-flex items-center gap-1.5 text-[9px] font-semibold text-navy">
					<HugeIcon name="phone" class="h-3 w-3 text-green" />
					Call our Salem team
				</a>
			</div>
			<ul class="mt-4 divide-y divide-line border-y border-line">
				{
					navItems.map((item) => (
						<li>
							<a
								href={item.href}
								class="group flex items-center justify-between gap-4 py-4 text-[17px] font-medium text-navy transition-colors hover:text-green"
							>
								<span class="flex items-baseline gap-3">
									<span class="text-[8px] font-semibold tracking-[0.16em] text-green">{item.number}</span>
									{item.label}
								</span>
								<span class="flex h-8 w-8 items-center justify-center rounded-none border border-line bg-cloud text-navy transition-all duration-300 group-hover:border-green/30 group-hover:bg-green-soft group-hover:text-green">
									<HugeIcon name="arrowUpRight" class="h-3.5 w-3.5" />
								</span>
							</a>
						</li>
					))
				}
			</ul>
			<div class="mt-5 grid gap-2 sm:grid-cols-2">
				<a href="#estimate" class="btn-primary w-full">
					Get My Free Estimate
					<HugeIcon name="arrowRight" class="h-4 w-4" />
				</a>
				<a href="https://wa.me/919655046464" class="btn-outline w-full">
					<HugeIcon name="whatsapp" class="h-4 w-4 text-green" />
					WhatsApp us
				</a>
			</div>
			<p class="mt-4 flex items-center gap-1.5 text-[9px] text-moss">
				<HugeIcon name="mapPin" class="h-3 w-3 text-green" />
				Salem, Tamil Nadu · Serving homes and businesses across the state
			</p>
		</nav>
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>("[data-site-header]");
	const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
	const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
	const iconOpen = document.querySelector<HTMLElement>("[data-menu-icon-open]");
	const iconClose = document.querySelector<HTMLElement>("[data-menu-icon-close]");

	if (header) {
		const updateHeader = () => {
			header.classList.toggle("shadow-[0_18px_50px_-34px_rgba(11,31,58,0.32)]", window.scrollY > 10);
		};
		updateHeader();
		window.addEventListener("scroll", updateHeader, { passive: true });
	}

	if (toggle && menu) {
		const setOpen = (open: boolean) => {
			menu.classList.toggle("hidden", !open);
			toggle.setAttribute("aria-expanded", String(open));
			toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
			iconOpen?.classList.toggle("hidden", open);
			iconClose?.classList.toggle("hidden", !open);
		};

		toggle.addEventListener("click", () => setOpen(menu.classList.contains("hidden")));
		menu.querySelectorAll("a").forEach((link) => {
			link.addEventListener("click", () => setOpen(false));
		});

		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape") setOpen(false);
		});

		window.addEventListener("resize", () => {
			if (window.innerWidth >= 1280) setOpen(false);
		});
	}
</script>
