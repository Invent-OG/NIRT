---
import HugeIcon from "./HugeIcon.astro";

const navItems = [
	{ label: "About", href: "#about", meta: "01" },
	{ label: "Solutions", href: "#solutions", meta: "02" },
	{ label: "Subsidy", href: "#subsidy", meta: "03" },
	{ label: "Projects", href: "#projects", meta: "04" },
	{ label: "Payment", href: "#payment", meta: "05" },
	{ label: "Process", href: "#process", meta: "06" },
	{ label: "Reviews", href: "#reviews", meta: "07" },
	{ label: "FAQ", href: "#faq", meta: "08" },
];
---

<header
	class="site-header fixed inset-x-0 top-0 z-50 transition-[background-color,border-color,backdrop-filter] duration-300"
	data-site-header
>
	<div
		class="container-page flex h-[84px] items-center justify-between gap-4"
	>
		<button
			type="button"
			class="group inline-flex items-center gap-2.5 text-white"
			aria-expanded="false"
			aria-controls="site-menu"
			data-menu-open
		>
			<span class="flex w-5 flex-col gap-[5px]" aria-hidden="true">
				<span
					class="h-px w-full bg-current transition-transform duration-300 group-hover:translate-x-1"
				></span>
				<span
					class="h-px w-full bg-current transition-transform duration-300 group-hover:-translate-x-1"
				></span>
				<span
					class="h-px w-3/4 bg-current transition-all duration-300 group-hover:w-full"
				></span>
			</span>
			<span class="text-[11px] font-medium uppercase tracking-[0.16em]"
				>Menu</span
			>
		</button>

		<!-- Main image logo -->
		<a
			href="#home"
			class="absolute left-1/2 flex -translate-x-1/2 items-center"
			aria-label="NIRT Renewable Energy — home"
		>
			<img
				src="/images/nirt-logo.webp"
				alt="NIRT Renewable Energy"
				width="160"
				height="48"
				class="h-10 w-auto object-contain"
				fetchpriority="high"
			/>
		</a>

		<div class="flex items-center gap-2.5">
			<a
				href="tel:+919655046464"
				class="hidden text-[12px] font-medium text-white/70 transition-colors hover:text-white md:inline-flex"
			>
				+91 96550 46464
			</a>

			<a
				href="#estimate"
				class="btn-primary hidden !min-h-[2.5rem] !px-4 !text-[11px] sm:inline-flex"
			>
				Contact us
				<HugeIcon name="arrowUpRight" class="h-3.5 w-3.5" />
			</a>

			<button
				type="button"
				class="grid h-9 w-9 place-items-center border border-white/25 text-white sm:hidden"
				aria-label="Open contact form"
				data-open-lead-dialog
			>
				<HugeIcon name="phone" class="h-4 w-4" />
			</button>
		</div>
	</div>
</header>

<div
	id="site-menu"
	class="site-menu fixed inset-0 z-[70] hidden overflow-y-auto bg-navy text-white"
	data-site-menu
>
	<div class="container-page relative flex min-h-full flex-col py-6">
		<div class="flex items-center justify-between">
			<p class="meta text-white/45">
				<span class="sm:hidden">Menu</span>
				<span class="hidden sm:inline"
					>Menu · NIRT Renewable Energy</span
				>
			</p>

			<!-- Menu image logo -->
			<a
				href="#home"
				class="absolute left-1/2 top-6 flex -translate-x-1/2 items-center"
				aria-label="NIRT Renewable Energy — home"
			>
				<img
					src="/images/nirt-logo.webp"
					alt="NIRT Renewable Energy"
					width="160"
					height="48"
					class="h-9 w-auto object-contain"
				/>
			</a>

			<button
				type="button"
				class="grid h-10 w-10 place-items-center border border-white/25 text-white transition-colors hover:border-yellow hover:text-yellow"
				aria-label="Close menu"
				data-menu-close
			>
				<HugeIcon name="close" class="h-4 w-4" />
			</button>
		</div>

		<div
			class="mt-10 grid flex-1 gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:items-start lg:gap-16"
		>
			<nav aria-label="Main navigation">
				<ul>
					{
						navItems.map((item) => (
							<li class="border-b border-white/12">
								<a
									href={item.href}
									class="group flex items-baseline justify-between gap-6 py-4 text-[2rem] font-medium leading-none tracking-[-0.04em] text-white transition-colors hover:text-yellow sm:text-[2.6rem] lg:text-[3rem]"
								>
									<span class="flex items-baseline gap-4">
										<span class="meta text-white/35 transition-colors group-hover:text-yellow">
											{item.meta}
										</span>
										{item.label}
									</span>

									<HugeIcon
										name="arrowUpRight"
										class="h-5 w-5 shrink-0 text-white/25 transition-all duration-300 group-hover:-translate-y-1 group-hover:translate-x-1 group-hover:text-yellow"
									/>
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<div class="flex flex-col justify-between gap-8">
				<div>
					<p class="meta text-white/40">Start here</p>

					<a
						href="#estimate"
						class="btn-primary mt-4 w-full sm:w-auto"
					>
						Get a free estimate
						<HugeIcon name="arrowRight" class="h-4 w-4" />
					</a>

					<p
						class="mt-3 max-w-[300px] text-[12px] leading-5 text-white/45"
					>
						Four details, one call from a Salem specialist. No
						obligation.
					</p>
				</div>

				<div
					class="grid gap-5 border-t border-white/12 pt-6 sm:grid-cols-2 lg:grid-cols-1"
				>
					<div>
						<p class="meta text-white/40">Call</p>
						<a
							href="tel:+919655046464"
							class="mt-1.5 block text-[17px] font-medium text-white hover:text-yellow"
						>
							+91 96550 46464
						</a>
						<p class="mt-1 text-[12px] text-white/40">
							Mon–Sat · 9am–6pm
						</p>
					</div>

					<div>
						<p class="meta text-white/40">Email</p>
						<a
							href="mailto:support@nirt.net"
							class="mt-1.5 block text-[15px] text-white/80 hover:text-yellow"
						>
							support@nirt.net
						</a>
					</div>

					<div>
						<p class="meta text-white/40">Field office</p>
						<p
							class="mt-1.5 max-w-[260px] text-[13px] leading-6 text-white/60"
						>
							#104/7, 3rd Floor, SPC Bhawan,<br />
							Manivannan Road, Alagapuram,<br />
							Salem, Tamil Nadu 636004
						</p>
					</div>
				</div>

				<div class="relative hidden overflow-hidden lg:block">
					<img
						src="/images/project-solar-park.webp"
						alt="NIRT's solar park at Harur, Tamil Nadu"
						width="1100"
						height="688"
						loading="lazy"
						class="h-[210px] w-full object-cover opacity-70"
					/>

					<div
						class="absolute inset-0 bg-gradient-to-t from-navy via-transparent to-transparent"
					>
					</div>

					<p
						class="absolute bottom-4 left-4 text-[11px] uppercase tracking-[0.14em] text-white/70"
					>
						15 MW · Harur, Tamil Nadu
					</p>
				</div>
			</div>
		</div>

		<div
			class="mt-10 flex flex-wrap items-center justify-between gap-3 border-t border-white/12 pt-5 text-white/35"
		>
			<p class="meta">Salem · Tamil Nadu</p>
			<p class="meta">Rooftop solar since 2017</p>
			<p class="meta">35+ MW installed</p>
		</div>
	</div>
</div>

<script>
	const header = document.querySelector<HTMLElement>("[data-site-header]");
	const menu = document.querySelector<HTMLElement>("[data-site-menu]");
	const openBtn =
		document.querySelector<HTMLButtonElement>("[data-menu-open]");
	const closeBtn =
		document.querySelector<HTMLButtonElement>("[data-menu-close]");

	if (header) {
		const update = () => {
			header.classList.toggle("is-scrolled", window.scrollY > 40);
		};

		update();
		window.addEventListener("scroll", update, { passive: true });
	}

	if (menu && openBtn && closeBtn) {
		const setOpen = (open: boolean) => {
			menu.classList.toggle("hidden", !open);
			openBtn.setAttribute("aria-expanded", String(open));
			document.documentElement.classList.toggle("overflow-hidden", open);

			if (open) {
				closeBtn.focus();
			} else {
				openBtn.focus();
			}
		};

		openBtn.addEventListener("click", () => setOpen(true));
		closeBtn.addEventListener("click", () => setOpen(false));

		menu.querySelectorAll("a").forEach((link) => {
			link.addEventListener("click", () => setOpen(false));
		});

		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && !menu.classList.contains("hidden")) {
				setOpen(false);
			}
		});
	}
</script>

<style>
	.site-header.is-scrolled {
		background: rgba(6, 19, 28, 0.94);
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
		backdrop-filter: blur(18px);
	}
</style>
