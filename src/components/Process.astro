---
import HugeIcon from "./HugeIcon.astro";

const steps = [
	{
		title: "Understand your requirements",
		copy: "We review your electricity consumption, property details, objectives and budget.",
	},
	{
		title: "Assess the site",
		copy: "Roof suitability, available space, shading and technical requirements are checked on site.",
	},
	{
		title: "Design the right solution",
		copy: "We determine capacity, system configuration, equipment and generation assumptions.",
	},
	{
		title: "Clarify the investment",
		copy: "A written quotation covering scope, subsidy information, payment terms and exclusions.",
	},
	{
		title: "Install and commission",
		copy: "Installation, electrical checks and the applicable net-metering or utility procedures.",
	},
	{
		title: "Handover and support",
		copy: "System operation, warranties and documentation — plus support after commissioning.",
	},
];
---

<section id="process" class="relative overflow-hidden bg-paper py-20 sm:py-24 lg:py-28">
	<div class="container-page relative">
		<div class="flex items-center justify-between gap-4 border-t border-ink/15 pt-4">
			<p class="meta text-ink/50">Method</p>
			<p class="meta text-ink/30">07 / Process</p>
		</div>

		<div class="mt-12 flex flex-col gap-7 lg:flex-row lg:items-end lg:justify-between lg:gap-16">
			<h2 class="display max-w-[650px] text-[2.6rem] leading-[0.98] text-ink sm:text-[3.4rem] lg:text-[4.2rem]">
				Six steps. No surprises.
			</h2>
			<div class="max-w-[320px]">
				<p class="text-[13.5px] leading-[1.8] text-body">
					From the first assessment to handover, you know who is doing what, when, and what it
					costs.
				</p>
				<p class="meta mt-4 inline-flex items-center gap-2 border border-ink/15 px-2.5 py-1.5 text-ink/55">
					<HugeIcon name="taskDone" class="h-3.5 w-3.5" />
					One team throughout
				</p>
			</div>
		</div>

		<ol class="mt-12 grid md:grid-cols-2 md:gap-x-12">
			{
				steps.map((step, index) => (
					<li class="reveal flex gap-5 border-t border-ink/20 py-6 sm:py-7" style={`transition-delay:${index * 50}ms`}>
						<span class="stat-number w-8 shrink-0 text-[1.1rem] text-ink/25">
							{String(index + 1).padStart(2, "0")}
						</span>
						<div>
							<h3 class="text-[15.5px] font-medium leading-[1.3] text-ink">{step.title}</h3>
							<p class="mt-1.5 max-w-[380px] text-[12.5px] leading-[1.7] text-body">{step.copy}</p>
						</div>
					</li>
				))
			}
		</ol>

		<div class="mt-4 flex flex-col gap-4 border-t border-ink/20 pt-6 sm:flex-row sm:items-center sm:justify-between">
			<p class="max-w-[420px] text-[13px] text-body">
				Ready to start with step one? A free site assessment in Salem and across Tamil Nadu.
			</p>
			<a href="#estimate" class="btn-primary shrink-0 self-start sm:self-auto">
				Book a free assessment
				<HugeIcon name="arrowRight" class="h-4 w-4" />
			</a>
		</div>
	</div>
</section>
