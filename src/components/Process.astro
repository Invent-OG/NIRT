---
import HugeIcon from "./HugeIcon.astro";

const steps = [
	{
		number: "01",
		title: "Understand requirements",
		copy: "We review your electricity consumption, property details, objectives and budget to define the project scope.",
	},
	{
		number: "02",
		title: "Assess the site",
		copy: "Roof suitability, available shadow-free space, structural stability and technical requirements are verified on site.",
	},
	{
		number: "03",
		title: "Design the solution",
		copy: "We engineer capacity, solar panel layout, inverter selection and realistic generation estimates before ordering.",
	},
	{
		number: "04",
		title: "Clarify the investment",
		copy: "A clear, transparent written proposal detailing scope, subsidy eligibility, payment schedule and guarantees.",
	},
	{
		number: "05",
		title: "Install and commission",
		copy: "Precision installation by certified engineers, strict safety checks, and complete net-metering utility grid paperwork.",
	},
	{
		number: "06",
		title: "Handover and support",
		copy: "System activation, monitoring app setup, official warranty documentation, and responsive ongoing maintenance support.",
	},
];
---

<section id="process" class="relative overflow-hidden bg-[#faf8f5] py-20 sm:py-24 lg:py-28 text-ink">
	<div class="container-page relative">
		<!-- Section Header -->
		<div class="flex items-center justify-between gap-4 border-b border-black/[0.08] pb-4">
			<p class="text-[12px] font-semibold uppercase tracking-[0.14em] text-orange-deep">
				Method
			</p>
			<p class="text-[12px] font-medium text-body/60">
				07 / Process
			</p>
		</div>

		<div class="reveal mt-10 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between lg:gap-16">
			<div class="max-w-[650px]">
				<h2 class="display text-[2.4rem] leading-[1.04] text-ink sm:text-[3.2rem] lg:text-[4rem] tracking-tight">
					Six steps. No surprises.
				</h2>
			</div>
			<div class="max-w-[340px]">
				<p class="text-[13.5px] leading-[1.75] text-body sm:text-[14.5px]">
					From the first assessment to handover, you know who is doing what, when, and what it costs.
				</p>
				<p class="mt-3 inline-flex items-center gap-2 rounded-full border border-black/[0.1] bg-white px-3.5 py-1 text-[11.5px] font-semibold text-ink">
					<HugeIcon name="taskDone" class="h-3.5 w-3.5 text-orange-deep" />
					One team throughout
				</p>
			</div>
		</div>

		<!-- Steps Grid with Giant Faded Numbers behind Title matching reference design -->
		<div class="mt-14 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-14 lg:gap-y-16 lg:mt-16">
			{
				steps.map((step, index) => (
					<div
						class="reveal relative flex flex-col"
						style={`transition-delay: ${index * 60}ms;`}
					>
						<!-- Giant gradient number behind the text with brand corporate blue & softer opacity -->
						<span
							class="pointer-events-none select-none block font-display text-[5.8rem] sm:text-[7rem] font-black leading-[0.82] tracking-tight bg-gradient-to-b from-[#154783]/35 via-[#154783]/12 to-transparent bg-clip-text text-transparent"
							aria-hidden="true"
						>
							{step.number}
						</span>

						<!-- Step Title overlapping the lower half of the gradient number -->
						<h3 class="relative z-10 -mt-7 sm:-mt-9 text-[1.3rem] sm:text-[1.4rem] font-bold text-ink tracking-tight">
							{step.title}
						</h3>

						<!-- Description Copy -->
						<p class="mt-3 text-[13.5px] sm:text-[14px] leading-[1.68] text-body max-w-[360px]">
							{step.copy}
						</p>
					</div>
				))
			}
		</div>

		<!-- Bottom Action Bar -->
		<div
			class="reveal mt-16 flex flex-col gap-6 rounded-2xl border border-black/[0.08] bg-white p-6 shadow-sm sm:flex-row sm:items-center sm:justify-between sm:p-7"
		>
			<div class="flex items-start gap-3.5">
				<span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-orange-500/10 text-orange-deep">
					<HugeIcon name="route" class="h-5 w-5" />
				</span>
				<div>
					<p class="text-[14px] font-bold text-ink">
						Ready to start with step one?
					</p>
					<p class="mt-0.5 text-[12.5px] leading-relaxed text-body">
						A free site assessment in Salem and across Tamil Nadu. No obligation, no pressure.
					</p>
				</div>
			</div>

			<a href="#estimate" class="btn-primary shrink-0 self-start sm:self-auto">
				Book a free assessment
				<HugeIcon name="arrowRight" class="h-4 w-4" />
			</a>
		</div>
	</div>
</section>
