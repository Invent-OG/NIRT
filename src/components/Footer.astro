---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";

const year = new Date().getFullYear();

const exploreLinks = [
	{ label: "Why Solar", href: "#why-solar" },
	{ label: "Subsidy", href: "#subsidy" },
	{ label: "Projects", href: "#projects" },
	{ label: "Payment Options", href: "#payment" },
	{ label: "Our Process", href: "#process" },
	{ label: "Reviews", href: "#reviews" },
];

const serviceLinks = [
	{ label: "Rooftop Solar", href: "#estimate" },
	{ label: "Commercial Solar", href: "#estimate" },
	{ label: "Solar Parks", href: "#projects" },
	{ label: "Energy Auditing", href: "https://www.nirt.net/" },
	{ label: "Biogas Solutions", href: "https://www.nirt.net/" },
];

const socials = [
	{
		label: "Facebook",
		href: "https://www.facebook.com/nirtrenewable/",
		icon: "facebook",
	},
	{
		label: "Instagram",
		href: "https://www.instagram.com/nirtrenewable/",
		icon: "instagram",
	},
	{
		label: "YouTube",
		href: "https://www.youtube.com/channel/UCmeZIkUTnL1PCEBdNs0jETw",
		icon: "youtube",
	},
	{
		label: "WhatsApp",
		href: "https://wa.me/919655046464",
		icon: "whatsapp",
	},
];
---

<footer id="contact" class="relative overflow-hidden bg-ink text-paper">
	<div class="solar-grid-light pointer-events-none absolute inset-0 opacity-25"></div>
	<div class="pointer-events-none absolute -right-32 -top-40 h-[480px] w-[480px] rounded-full border border-white/5"></div>
	<div class="pointer-events-none absolute -left-40 bottom-0 h-[420px] w-[420px] rounded-full bg-forest/15 blur-3xl"></div>
	<div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-solar/40 to-transparent"></div>

	<div class="container-page relative pb-8 pt-14 lg:pt-16">
		<div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.35fr_0.65fr_0.72fr_1fr] lg:gap-12">
			<div class="sm:col-span-2 lg:col-span-1">
				<Logo variant="light" />
				<p class="mt-5 max-w-[330px] text-[10.5px] leading-[1.9] text-white/45">
					Rooftop solar, energy auditing and biogas solutions from Salem, Tamil Nadu.
					Serving homes, housing societies and businesses across the state since 2017.
				</p>

				<div class="mt-5 flex flex-wrap items-center gap-2">
					<span class="rounded-full border border-white/10 bg-white/[0.04] px-2.5 py-1 text-[7.5px] font-medium uppercase tracking-[0.11em] text-white/55">
						35+ MW solar portfolio
					</span>
					<span class="rounded-full border border-white/10 bg-white/[0.04] px-2.5 py-1 text-[7.5px] font-medium uppercase tracking-[0.11em] text-white/55">
						MNRE / TEDA experience
					</span>
				</div>

				<div class="mt-6 flex items-center gap-2.5">
					{
						socials.map((social) => (
							<a
								href={social.href}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={social.label}
								class="flex h-8 w-8 items-center justify-center rounded-full border border-white/10 bg-white/[0.04] text-white/55 transition-all hover:border-solar/35 hover:bg-solar/10 hover:text-solar"
							>
								{social.icon === "facebook" && (
									<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
										<path d="M14.5 8.5h3V5h-3c-2.5 0-4.5 2-4.5 4.5V12H7v3.5h3V22h3.5v-6.5h3l.5-3.5h-3.5V9.7c0-.7.3-1.2 1.5-1.2Z" />
									</svg>
								)}
								{social.icon === "instagram" && (
									<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
										<rect x="3.5" y="3.5" width="17" height="17" rx="5" />
										<circle cx="12" cy="12" r="4" />
										<circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none" />
									</svg>
								)}
								{social.icon === "youtube" && (
									<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
										<rect x="2.5" y="5.5" width="19" height="13" rx="3.5" />
										<path d="m10 9 5 3-5 3V9Z" fill="currentColor" stroke="none" />
									</svg>
								)}
								{social.icon === "whatsapp" && (
									<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
										<path d="M17.5 14.4c-.3-.2-1.8-.9-2-1-.3-.1-.5-.2-.7.1-.2.3-.8 1-.9 1.2-.2.2-.4.2-.7.1-.3-.1-1.2-.5-2.3-1.4-.8-.7-1.4-1.6-1.6-1.9-.2-.3 0-.5.1-.6l.5-.6c.1-.2.2-.3.2-.5.1-.2 0-.4 0-.5s-.7-1.7-.9-2.3c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.5.2-.7.2-1.3.2-1.5-.1-.1-.3-.2-.6-.4Z" />
										<path d="M12 2.2a9.7 9.7 0 0 0-8.4 14.6L2.2 21.8l5.1-1.3A9.7 9.7 0 1 0 12 2.2Zm0 17.7c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A7.9 7.9 0 1 1 12 19.9Z" />
									</svg>
								)}
							</a>
						))
					}
				</div>
			</div>

			<div>
				<h2 class="text-[8.5px] font-semibold uppercase tracking-[0.18em] text-solar">Explore</h2>
				<ul class="mt-5 grid grid-cols-2 gap-x-5 gap-y-3 sm:grid-cols-1">
					{
						exploreLinks.map((link) => (
							<li>
								<a href={link.href} class="text-[10.5px] text-white/45 transition-colors hover:text-white">
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div>
				<h2 class="text-[8.5px] font-semibold uppercase tracking-[0.18em] text-solar">Services</h2>
				<ul class="mt-5 grid grid-cols-2 gap-x-5 gap-y-3 sm:grid-cols-1">
					{
						serviceLinks.map((link) => (
							<li>
								<a
									href={link.href}
									class="text-[10.5px] text-white/45 transition-colors hover:text-white"
									{...(link.href.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {})}
								>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div>
				<h2 class="text-[8.5px] font-semibold uppercase tracking-[0.18em] text-solar">Contact</h2>
				<ul class="mt-5 space-y-3.5">
					<li>
						<a href="tel:+919655046464" class="group flex items-start gap-3 text-[10.5px] text-white/55 transition-colors hover:text-white">
							<svg class="mt-0.5 h-3.5 w-3.5 shrink-0 text-solar/80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
								<path d="M6.2 3.5h2.5l1.2 3.3-1.5 1.2a11 11 0 0 0 6.6 6.6l1.2-1.5 3.3 1.2v2.5c0 .9-.7 1.7-1.7 1.7A16 16 0 0 1 4.5 5.2c0-.9.8-1.7 1.7-1.7Z" stroke-linejoin="round" />
							</svg>
							<span>
								+91 96550 46464
								<span class="mt-0.5 block text-[8.5px] text-white/35">Mobile · Mon–Sat</span>
							</span>
						</a>
					</li>
					<li>
						<a href="tel:+914277961461" class="flex items-center gap-3 text-[10.5px] text-white/55 transition-colors hover:text-white">
							<svg class="h-3.5 w-3.5 shrink-0 text-solar/80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
								<path d="M4.5 5h4l1.5 4-2 1.5a12 12 0 0 0 5.5 5.5l1.5-2 4 1.5v4c0 .8-.7 1.5-1.5 1.5A16.5 16.5 0 0 1 3 6.5C3 5.7 3.7 5 4.5 5Z" stroke-linejoin="round" />
							</svg>
							0427 796 1461
						</a>
					</li>
					<li>
						<a href="mailto:support@nirt.net" class="flex items-center gap-3 text-[10.5px] text-white/55 transition-colors hover:text-white">
							<svg class="h-3.5 w-3.5 shrink-0 text-solar/80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
								<rect x="3" y="5" width="18" height="14" rx="2" />
								<path d="m3.5 6 8.5 7 8.5-7" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
							support@nirt.net
						</a>
					</li>
					<li class="flex items-start gap-3 text-[10px] leading-[1.8] text-white/40">
						<svg class="mt-0.5 h-3.5 w-3.5 shrink-0 text-solar/80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
							<path d="M12 21s7-6.4 7-11a7 7 0 1 0-14 0c0 4.6 7 11 7 11Z" />
							<circle cx="12" cy="10" r="2.4" />
						</svg>
						<span>
							#104/7, 3rd Floor, SPC Bhawan,<br />
							Manivannan Road, Alagapuram,<br />
							Salem, Tamil Nadu 636004
						</span>
					</li>
					<li>
						<a href="https://www.nirt.net/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-[10.5px] text-white/55 transition-colors hover:text-white">
							<svg class="h-3.5 w-3.5 shrink-0 text-solar/80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
								<circle cx="12" cy="12" r="9" />
								<path d="M3.5 12h17M12 3c2.4 2.5 3.6 5.5 3.6 9s-1.2 6.5-3.6 9c-2.4-2.5-3.6-5.5-3.6-9S9.6 5.5 12 3Z" />
							</svg>
							nirt.net
						</a>
					</li>
				</ul>
			</div>
		</div>

		<div class="relative mt-12 border-t border-white/10 pt-6">
			<div class="flex flex-col gap-4 text-[8.5px] leading-[1.8] text-white/40 lg:flex-row lg:items-start lg:justify-between lg:gap-10">
				<p class="max-w-[640px]">
					Subsidy, generation and EMI figures are indicative and subject to eligibility, site
					conditions, component warranties, scheme guidelines and lender terms. PM Surya Ghar
					is a Government of India scheme; NIRT is not a government agency.
				</p>
				<p class="shrink-0 text-white/35">© {year} NIRT Renewable Energy Pvt Ltd.</p>
			</div>
			<p class="mt-3 text-[8px] text-white/30">All rights reserved. Registered office: Salem, Tamil Nadu.</p>
		</div>
	</div>

	<div class="relative border-t border-white/10">
		<div class="container-page flex flex-col items-center justify-between gap-2 py-4 text-[8.5px] text-white/40 sm:flex-row">
			<p>Rooftop solar · Energy auditing · Biogas · Since 2017</p>
			<a href="#home" class="inline-flex items-center gap-1.5 transition-colors hover:text-white/70">
				Back to top
				<Icon name="arrow-up-right" class="h-3 w-3" />
			</a>
		</div>
	</div>

	<div class="pointer-events-none relative h-[13vw] max-h-[160px] overflow-hidden" aria-hidden="true">
		<p class="display absolute -bottom-[0.18em] left-1/2 -translate-x-1/2 whitespace-nowrap text-[25vw] leading-[0.7] text-white/[0.035] select-none">
			NIRT
		</p>
	</div>

	<div class="h-16 sm:hidden"></div>
</footer>
