---
import Logo from "./Logo.astro";
import HugeIcon from "./HugeIcon.astro";
import type { IconName } from "../icons";

const year = new Date().getFullYear();

const exploreLinks = [
	{ label: "Why Solar", href: "#why-solar" },
	{ label: "Subsidy", href: "#subsidy" },
	{ label: "Projects", href: "#projects" },
	{ label: "Payment Options", href: "#payment" },
	{ label: "Our Process", href: "#process" },
	{ label: "Reviews", href: "#reviews" },
];

const serviceLinks = [
	{ label: "Rooftop Solar", href: "#estimate" },
	{ label: "Commercial Solar", href: "#estimate" },
	{ label: "Solar Parks", href: "#projects" },
	{ label: "Energy Auditing", href: "https://www.nirt.net/" },
	{ label: "Biogas Solutions", href: "https://www.nirt.net/" },
];

const socials: { label: string; href: string; icon: IconName }[] = [
	{ label: "Facebook", href: "https://www.facebook.com/nirtrenewable/", icon: "facebook" },
	{ label: "Instagram", href: "https://www.instagram.com/nirtrenewable/", icon: "instagram" },
	{ label: "YouTube", href: "https://www.youtube.com/channel/UCmeZIkUTnL1PCEBdNs0jETw", icon: "youtube" },
	{ label: "WhatsApp", href: "https://wa.me/919655046464", icon: "whatsapp" },
];
---

<footer id="contact" class="relative overflow-hidden border-t border-navy/10 bg-cloud text-navy">
	<div class="pointer-events-none absolute -right-32 -top-40 h-[480px] w-[480px] rounded-none border border-navy/[0.05]"></div>
	<div class="pointer-events-none absolute -left-40 bottom-0 h-[420px] w-[420px] rounded-none bg-green/[0.07] blur-3xl"></div>
	<div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-green/40 to-transparent"></div>

	<div class="container-page relative pb-8 pt-14 lg:pt-16">
		<div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.3fr_0.65fr_0.72fr_1fr] lg:gap-12">
			<div class="sm:col-span-2 lg:col-span-1">
				<Logo size="lg" />
				<p class="mt-5 max-w-[330px] text-[10.5px] leading-[1.9] text-body">
					Rooftop solar, energy auditing and biogas solutions from Salem, Tamil Nadu. Serving
					homes, housing societies and businesses across the state since 2017.
				</p>

				<div class="mt-5 flex flex-wrap items-center gap-2">
					<span class="rounded-none border border-green/15 bg-green-soft px-2.5 py-1 text-[7.5px] font-semibold uppercase tracking-[0.11em] text-green-deep">
						35+ MW solar portfolio
					</span>
					<span class="rounded-none border border-navy/10 bg-white px-2.5 py-1 text-[7.5px] font-semibold uppercase tracking-[0.11em] text-navy/65">
						MNRE / TEDA experience
					</span>
				</div>

				<div class="mt-6 flex items-center gap-2.5">
					{
						socials.map((social) => (
							<a
								href={social.href}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={social.label}
								class="flex h-8 w-8 items-center justify-center rounded-none border border-navy/10 bg-white text-navy/60 transition-all hover:-translate-y-0.5 hover:border-green/30 hover:bg-green-soft hover:text-green"
							>
								<HugeIcon name={social.icon} class="h-3.5 w-3.5" />
							</a>
						))
					}
				</div>
			</div>

			<div>
				<h2 class="text-[8.5px] font-semibold uppercase tracking-[0.18em] text-green">Explore</h2>
				<ul class="mt-5 grid grid-cols-2 gap-x-5 gap-y-3 sm:grid-cols-1">
					{
						exploreLinks.map((link) => (
							<li>
								<a href={link.href} class="text-[10.5px] text-body transition-colors hover:text-green">
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div>
				<h2 class="text-[8.5px] font-semibold uppercase tracking-[0.18em] text-green">Services</h2>
				<ul class="mt-5 grid grid-cols-2 gap-x-5 gap-y-3 sm:grid-cols-1">
					{
						serviceLinks.map((link) => (
							<li>
								<a
									href={link.href}
									class="text-[10.5px] text-body transition-colors hover:text-green"
									{...(link.href.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {})}
								>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div>
				<h2 class="text-[8.5px] font-semibold uppercase tracking-[0.18em] text-green">Contact</h2>
				<ul class="mt-5 space-y-3.5">
					<li>
						<a href="tel:+919655046464" class="group flex items-start gap-3 text-[10.5px] text-body transition-colors hover:text-navy">
							<span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-none bg-green-soft text-green">
								<HugeIcon name="phone" class="h-2.5 w-2.5" />
							</span>
							<span>
								+91 96550 46464
								<span class="mt-0.5 block text-[8.5px] text-moss">Mobile · Mon–Sat</span>
							</span>
						</a>
					</li>
					<li>
						<a href="tel:+914277961461" class="flex items-center gap-3 text-[10.5px] text-body transition-colors hover:text-navy">
							<span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-none bg-green-soft text-green">
								<HugeIcon name="phone" class="h-2.5 w-2.5" />
							</span>
							0427 796 1461
						</a>
					</li>
					<li>
						<a href="mailto:support@nirt.net" class="flex items-center gap-3 text-[10.5px] text-body transition-colors hover:text-navy">
							<span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-none bg-green-soft text-green">
								<HugeIcon name="mail" class="h-2.5 w-2.5" />
							</span>
							support@nirt.net
						</a>
					</li>
					<li class="flex items-start gap-3 text-[10px] leading-[1.8] text-body">
						<span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-none bg-orange-soft text-orange-deep">
							<HugeIcon name="mapPin" class="h-2.5 w-2.5" />
						</span>
						<span>
							#104/7, 3rd Floor, SPC Bhawan,<br />
							Manivannan Road, Alagapuram,<br />
							Salem, Tamil Nadu 636004
						</span>
					</li>
					<li>
						<a
							href="https://www.nirt.net/"
							target="_blank"
							rel="noopener noreferrer"
							class="flex items-center gap-3 text-[10.5px] text-body transition-colors hover:text-navy"
						>
							<span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-none bg-navy-tint text-navy">
								<HugeIcon name="globe" class="h-2.5 w-2.5" />
							</span>
							nirt.net
						</a>
					</li>
				</ul>
			</div>
		</div>

		<div class="relative mt-12 border-t border-navy/10 pt-6">
			<div class="flex flex-col gap-4 text-[8.5px] leading-[1.8] text-moss lg:flex-row lg:items-start lg:justify-between lg:gap-10">
				<p class="max-w-[640px]">
					Subsidy, generation and EMI figures are indicative and subject to eligibility, site
					conditions, component warranties, scheme guidelines and lender terms. PM Surya Ghar is
					a Government of India scheme; NIRT is not a government agency.
				</p>
				<p class="shrink-0 text-navy/50">© {year} NIRT Renewable Energy Pvt Ltd.</p>
			</div>
			<p class="mt-3 text-[8px] text-moss/70">All rights reserved. Registered office: Salem, Tamil Nadu.</p>
		</div>
	</div>

	<div class="relative border-t border-navy/10">
		<div class="container-page flex flex-col items-center justify-between gap-2 py-4 text-[8.5px] text-moss sm:flex-row">
			<p>Rooftop solar · Energy auditing · Biogas · Since 2017</p>
			<a href="#home" class="inline-flex items-center gap-1.5 transition-colors hover:text-navy">
				Back to top
				<HugeIcon name="arrowUpRight" class="h-3 w-3" />
			</a>
		</div>
	</div>

	<div class="pointer-events-none relative h-[12vw] max-h-[150px] overflow-hidden" aria-hidden="true">
		<p
			class="display absolute -bottom-[0.18em] left-1/2 -translate-x-1/2 select-none whitespace-nowrap text-[24vw] leading-[0.7] text-navy/[0.035]"
		>
			NIRT
		</p>
	</div>

	<div class="h-20 sm:hidden"></div>
</footer>
