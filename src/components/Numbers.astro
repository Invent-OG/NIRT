---
import HugeIcon from "./HugeIcon.astro";
---

<section
	id="why-solar"
	class="relative overflow-hidden bg-white py-18 sm:py-22 lg:py-28"
>
	<div
		class="solar-grid pointer-events-none absolute inset-y-0 right-0 w-[42%] opacity-45 [mask-image:linear-gradient(270deg,black,transparent)]"
	>
	</div>
	<div
		class="pointer-events-none absolute -left-40 top-10 h-[420px] w-[420px] rounded-none bg-green/[0.08] blur-3xl"
	>
	</div>

	<div class="container-page relative">
		<div
			class="grid gap-8 lg:grid-cols-[1.08fr_0.72fr] lg:items-end lg:gap-20"
		>
			<div class="reveal">
				<p class="eyebrow text-green">Solar, understood</p>
				<h2
					class="display mt-5 max-w-[760px] text-[2.5rem] text-navy sm:text-[3.1rem] lg:text-[3.65rem]"
				>
					Solar is an <span class="text-green">investment</span> you should
					understand.
				</h2>
			</div>
			<div class="reveal" style="transition-delay:80ms">
				<p
					class="max-w-[420px] text-[12.5px] leading-[1.9] text-body sm:text-[13.5px]"
				>
					Explore the numbers that shape your system, your generation
					and your return — before anyone asks you to sign.
				</p>
				<button
					type="button"
					class="btn-outline group mt-6"
					data-open-lead-dialog
				>
					Explore my solar potential
					<HugeIcon name="arrowRight" class="h-4 w-4" />
				</button>
			</div>
		</div>

		<div class="mt-10 grid gap-4 lg:mt-12 lg:grid-cols-12">
			<article
				class="grain grain-dark reveal group relative flex min-h-[370px] flex-col overflow-hidden rounded-none bg-navy p-6 text-white sm:p-7 lg:col-span-4 lg:row-span-2 lg:min-h-[500px]"
			>
				<div
					class="solar-grid-light pointer-events-none absolute inset-0 opacity-25"
				>
				</div>
				<div
					class="pointer-events-none absolute -right-24 -top-24 h-64 w-64 rounded-none border border-white/10"
				>
				</div>
				<div
					class="pointer-events-none absolute -right-8 top-8 h-40 w-40 rounded-none border border-dashed border-green/30"
				>
				</div>
				<div
					class="pointer-events-none absolute -bottom-16 -left-16 h-56 w-56 rounded-none bg-green/20 blur-3xl"
				>
				</div>
				<div
					class="pointer-events-none absolute right-10 top-10 h-16 w-16 rounded-none bg-orange/20 blur-2xl"
				>
				</div>

				<div
					class="relative z-[2] flex items-start justify-between gap-4"
				>
					<span
						class="text-[8px] font-semibold uppercase tracking-[0.18em] text-white/45"
						>01 / Lifespan</span
					>
					<span
						class="flex h-9 w-9 items-center justify-center rounded-none border border-white/12 bg-white/[0.06] text-orange"
					>
						<HugeIcon name="sun" class="h-4 w-4" />
					</span>
				</div>

				<div
					class="relative z-[2] mt-12 flex flex-1 flex-col justify-end"
				>
					<div class="relative mb-8 h-24 w-24">
						<span
							class="absolute inset-0 rounded-none border border-white/12"
						></span>
						<span
							class="absolute inset-3 rounded-none border border-dashed border-green/40"
						></span>
						<span
							class="absolute inset-6 rounded-none bg-green/15 blur-md"
						></span>
						<span
							class="absolute left-1/2 top-1/2 h-2 w-2 -translate-x-1/2 -translate-y-1/2 rounded-none bg-orange shadow-[0_0_22px_6px_rgba(240,95,35,0.38)]"
						></span>
						<span
							class="absolute right-2 top-3 h-1.5 w-1.5 rounded-none bg-green"
						></span>
						<span
							class="absolute bottom-4 left-1 h-1 w-1 rounded-none bg-white/40"
						></span>
					</div>
					<p
						class="stat-number text-[5rem] leading-[0.82] text-white sm:text-[5.4rem]"
					>
						25<span
							class="ml-2 font-sans text-[0.95rem] font-medium tracking-[0.02em] text-orange-light"
							>years</span
						>
					</p>
					<p
						class="mt-4 text-[8.5px] font-semibold uppercase tracking-[0.17em] text-green-mid"
					>
						Potential system lifespan
					</p>
					<p
						class="mt-3 max-w-[270px] text-[10.5px] leading-[1.8] text-white/50"
					>
						Grid-connected rooftop systems can keep producing for 25
						years. Component warranties and real-world performance
						vary.
					</p>
				</div>

				<div
					class="relative z-[2] mt-6 flex items-center gap-2 border-t border-white/10 pt-4 text-[8px] uppercase tracking-[0.16em] text-white/35"
				>
					<span
						class="h-1.5 w-1.5 rounded-none bg-orange"
						aria-hidden="true"></span>
					Designed for the long run
				</div>
			</article>

			<article
				class="reveal group relative flex flex-col overflow-hidden rounded-none border border-green/15 bg-green-soft p-6 text-navy sm:p-7 lg:col-span-8"
				style="transition-delay:60ms"
			>
				<div
					class="pointer-events-none absolute -right-20 -top-24 h-64 w-64 rounded-none border border-green/15"
				>
				</div>
				<div
					class="pointer-events-none absolute -right-10 top-0 h-44 w-44 rounded-none bg-white/40 blur-2xl"
				>
				</div>

				<div
					class="relative z-[2] flex items-start justify-between gap-4"
				>
					<span
						class="text-[8px] font-semibold uppercase tracking-[0.18em] text-green-deep/60"
					>
						02 / Support
					</span>
					<span
						class="flex h-9 w-9 items-center justify-center rounded-none border border-green/20 bg-white/60 text-green"
					>
						<HugeIcon name="moneyReceive" class="h-4 w-4" />
					</span>
				</div>

				<div
					class="relative z-[2] mt-6 flex flex-wrap items-end justify-between gap-5"
				>
					<div>
						<p
							class="whitespace-nowrap font-sans text-[1.8rem] font-semibold leading-none tracking-[-0.055em] tabular-nums sm:text-[2.4rem] lg:text-[2.9rem]"
						>
							₹35,000<span class="mx-1.5 text-navy/25">–</span
							>₹1,00,000
						</p>
						<p
							class="mt-2.5 text-[8.5px] font-semibold uppercase tracking-[0.16em] text-green-deep/70"
						>
							Potential combined subsidy*
						</p>
					</div>
					<span
						class="inline-flex items-center gap-1.5 rounded-none bg-white/70 px-3 py-1.5 text-[8px] font-semibold uppercase tracking-[0.1em] text-green-deep"
					>
						<HugeIcon name="badgeCheck" class="h-3 w-3" />
						PM Surya Ghar
					</span>
				</div>

				<div class="relative z-[2] mt-6 grid gap-2 sm:grid-cols-3">
					{
						[
							["1 kW", "₹30,000", "36%"],
							["2 kW", "₹60,000", "72%"],
							["3 kW+", "₹1,00,000", "100%"],
						].map(([size, amount, width]) => (
							<div class="rounded-none border border-green/12 bg-white/60 px-3 py-2.5 backdrop-blur-sm">
								<div class="flex items-baseline justify-between gap-2">
									<span class="text-[8px] font-semibold text-navy/55">
										{size}
									</span>
									<span class="text-[9px] font-semibold text-navy">
										{amount}
									</span>
								</div>
								<span class="mt-2 block h-1 overflow-hidden rounded-none bg-green/10">
									<span
										class="block h-full rounded-none bg-green"
										style={`width:${width}`}
									/>
								</span>
							</div>
						))
					}
				</div>

				<p
					class="relative z-[2] mt-4 max-w-[560px] text-[9.5px] leading-[1.7] text-green-deep/65"
				>
					For eligible residential systems under the current scheme's
					1–3 kW examples. Support is credited through the official
					process.
				</p>
			</article>

			<article
				class="premium-card reveal group flex flex-col p-6 sm:p-7 lg:col-span-4"
				style="transition-delay:120ms"
			>
				<div class="flex items-start justify-between gap-3">
					<span
						class="text-[8px] font-semibold uppercase tracking-[0.18em] text-moss/70"
						>03 / Capacity</span
					>
					<span
						class="icon-tile icon-tile-green h-9 w-9 text-green transition-colors duration-300 group-hover:bg-navy group-hover:text-orange"
					>
						<HugeIcon name="solarPanel" class="h-4 w-4" />
					</span>
				</div>
				<div class="mt-8">
					<p class="leading-none text-navy">
						<span class="stat-number text-[2.7rem]">1–3</span>
						<span
							class="ml-1.5 font-sans text-[0.9rem] font-semibold tracking-[0.02em]"
							>kW+</span
						>
					</p>
					<p
						class="mt-3 text-[8px] font-semibold uppercase tracking-[0.15em] text-green"
					>
						System capacity
					</p>
					<p class="mt-3 text-[10.5px] leading-[1.8] text-body">
						Sized around your consumption, roof suitability and how
						your home uses power.
					</p>
				</div>
				<div class="mt-auto pt-6">
					<div
						class="h-[3px] w-full overflow-hidden rounded-none bg-navy/8"
					>
						<div
							class="h-[3px] w-0 rounded-none bg-green transition-all duration-500 group-hover:w-2/3"
						>
						</div>
					</div>
				</div>
			</article>

			<article
				class="premium-card reveal group flex flex-col p-6 sm:p-7 lg:col-span-4"
				style="transition-delay:180ms"
			>
				<div class="flex items-start justify-between gap-3">
					<span
						class="text-[8px] font-semibold uppercase tracking-[0.18em] text-moss/70"
						>04 / Generation</span
					>
					<span
						class="icon-tile icon-tile-orange h-9 w-9 text-orange transition-colors duration-300 group-hover:bg-navy group-hover:text-orange"
					>
						<HugeIcon name="bolt" class="h-4 w-4" />
					</span>
				</div>
				<div class="mt-8">
					<p class="leading-none text-navy">
						<span class="stat-number text-[2.7rem]">4–5</span>
						<span
							class="ml-1.5 font-sans text-[0.9rem] font-semibold tracking-[0.02em]"
							>units*</span
						>
					</p>
					<p
						class="mt-3 text-[8px] font-semibold uppercase tracking-[0.15em] text-green"
					>
						Daily generation per kW
					</p>
					<p class="mt-3 text-[10.5px] leading-[1.8] text-body">
						A rule of thumb. Real output varies with location,
						season, orientation and shading.
					</p>
				</div>
				<div class="mt-auto pt-6">
					<div
						class="h-[3px] w-full overflow-hidden rounded-none bg-navy/8"
					>
						<div
							class="h-[3px] w-0 rounded-none bg-orange transition-all duration-500 group-hover:w-2/3"
						>
						</div>
					</div>
				</div>
			</article>
		</div>

		<div
			class="mt-8 flex flex-col gap-3 border-t border-line pt-4 text-[9px] leading-4 text-moss sm:flex-row sm:items-start sm:justify-between"
		>
			<p class="max-w-[630px]">
				*Indicative figures only. Generation, lifespan and subsidy
				depend on site conditions, component warranties and current
				scheme eligibility.
			</p>
			<p
				class="shrink-0 text-[8px] uppercase tracking-[0.16em] text-moss/60"
			>
				NIRT · Solar, understood
			</p>
		</div>
	</div>

	<div data-popup-trigger class="h-px w-full" aria-hidden="true"></div>
</section>
