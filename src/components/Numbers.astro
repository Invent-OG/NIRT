---
import Icon from "./Icon.astro";
---

<section id="why-solar" class="relative overflow-hidden bg-cream py-18 sm:py-22 lg:py-28">
	<div class="solar-grid pointer-events-none absolute inset-y-0 left-0 w-[40%] opacity-40 [mask-image:linear-gradient(90deg,black,transparent)]"></div>
	<div class="pointer-events-none absolute -left-32 top-10 h-96 w-96 rounded-full bg-solar/[0.13] blur-3xl"></div>
	<div class="pointer-events-none absolute -right-40 bottom-0 h-[420px] w-[420px] rounded-full border border-ink/[0.04]"></div>

	<div class="container-page relative">
		<div class="grid gap-10 lg:grid-cols-1 xl:grid-cols-[0.82fr_1.18fr] xl:items-start xl:gap-16 2xl:gap-20">
			<div class="reveal xl:sticky xl:top-32">
				<p class="eyebrow text-forest">Solar, understood</p>
				<h2 class="display mt-5 max-w-[500px] text-[2.5rem] text-ink sm:text-[3rem] lg:text-[3.25rem]">
					Solar is more than panels on your roof. It's an <em class="text-forest">investment</em> you should understand.
				</h2>
				<p class="mt-5 max-w-[410px] text-[12.5px] leading-[1.9] text-body sm:text-[13.5px]">
					Explore the numbers that influence your solar system, energy generation and
					investment — before anyone asks you to sign.
				</p>

				<button type="button" class="btn-outline group mt-8" data-open-lead-dialog>
					Explore My Solar Potential
					<svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
						<path d="M2.5 8h10M8.5 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</button>

				<div class="mt-10 hidden items-start gap-3 border-t border-ink/10 pt-5 lg:flex">
					<span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-ink/10 bg-white/50 text-forest">
						<Icon name="bolt" class="h-3.5 w-3.5" />
					</span>
					<p class="max-w-[250px] text-[10px] leading-[1.7] text-moss">
						A clear starting point — before any site visit, commitment or payment.
					</p>
				</div>
			</div>

			<div class="grid gap-3.5 sm:grid-cols-2 sm:gap-4 lg:grid-cols-6">
				<article class="grain grain-dark reveal group relative flex min-h-[330px] flex-col overflow-hidden rounded-[26px] bg-ink p-6 text-paper sm:col-span-2 sm:p-7 lg:col-span-2 lg:row-span-2 lg:min-h-[430px]">
					<div class="pointer-events-none absolute -right-20 -top-20 h-56 w-56 rounded-full border border-white/[0.07]"></div>
					<div class="pointer-events-none absolute -right-8 -top-8 h-36 w-36 rounded-full bg-solar/[0.08] blur-2xl"></div>
					<div class="pointer-events-none absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-black/20 to-transparent"></div>

					<div class="relative z-[2] flex items-start justify-between">
						<span class="text-[8px] font-semibold uppercase tracking-[0.18em] text-white/35">
							01 / Lifespan
						</span>
						<span class="flex h-8 w-8 items-center justify-center rounded-full border border-white/10 text-solar">
							<Icon name="sun" class="h-3.5 w-3.5" />
						</span>
					</div>

					<div class="relative z-[2] mt-12 flex flex-1 flex-col justify-end">
						<div class="relative mb-7 h-24 w-24">
							<span class="absolute inset-0 rounded-full border border-white/10"></span>
							<span class="absolute inset-3 rounded-full border border-dashed border-solar/30"></span>
							<span class="absolute inset-6 rounded-full bg-solar/10 blur-md"></span>
							<span class="absolute left-1/2 top-1/2 h-1.5 w-1.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-solar shadow-[0_0_20px_5px_rgba(239,178,74,0.35)]"></span>
							<span class="absolute right-2 top-3 h-1 w-1 rounded-full bg-solar/70"></span>
							<span class="absolute bottom-4 left-1 h-1 w-1 rounded-full bg-white/30"></span>
						</div>
						<p class="display text-[4.6rem] leading-[0.85] text-paper sm:text-[5rem]">
							25<span class="ml-1.5 font-sans text-[0.9rem] font-medium tracking-[0.02em] text-solar">years</span>
						</p>
						<p class="mt-3 text-[8.5px] font-semibold uppercase tracking-[0.17em] text-solar">
							Potential system lifespan
						</p>
						<p class="mt-3 max-w-[260px] text-[10.5px] leading-[1.8] text-white/48">
							Grid-connected rooftop systems can keep producing for 25 years. Component
							warranties and real-world performance vary.
						</p>
					</div>

					<div class="relative z-[2] mt-6 flex items-center gap-2 border-t border-white/10 pt-4 text-[8px] uppercase tracking-[0.16em] text-white/30">
						<span class="h-1 w-1 rounded-full bg-solar" aria-hidden="true"></span>
						Designed for the long run
					</div>
				</article>

				<article class="edge-gold grain reveal group relative flex flex-col overflow-hidden rounded-[26px] p-6 sm:col-span-2 sm:p-7 lg:col-span-4">
					<div class="pointer-events-none absolute inset-px rounded-[25px] bg-[linear-gradient(135deg,rgba(248,221,168,0.85),rgba(239,178,74,0.5))]"></div>
					<div class="pointer-events-none absolute -right-10 -top-16 h-48 w-48 rounded-full border border-ink/10"></div>
					<div class="pointer-events-none absolute -right-2 -top-8 h-32 w-32 rounded-full border border-ink/[0.06]"></div>

					<div class="relative z-[2] flex items-start justify-between">
						<span class="text-[8px] font-semibold uppercase tracking-[0.18em] text-ink/45">
							02 / Support
						</span>
						<span class="flex h-8 w-8 items-center justify-center rounded-full border border-ink/10 bg-white/30 text-ink/70">
							<Icon name="wallet" class="h-3.5 w-3.5" />
						</span>
					</div>

					<div class="relative z-[2] mt-7">
						<p class="font-sans text-[2.2rem] font-semibold leading-none tracking-[-0.055em] text-ink tabular-nums sm:text-[2.7rem]">
							₹35,000<span class="mx-1 text-ink/35">–</span>₹78,000
						</p>
						<p class="mt-2.5 text-[8.5px] font-semibold uppercase tracking-[0.16em] text-ink/55">
							Potential combined subsidy*
						</p>
					</div>

					<div class="relative z-[2] mt-6 grid grid-cols-3 gap-2">
						{
							[
								["1 kW", "₹30,000", "36%"],
								["2 kW", "₹60,000", "72%"],
								["3 kW+", "₹78,000", "100%"],
							].map(([size, amount, width]) => (
								<div class="rounded-xl border border-ink/10 bg-white/20 px-2.5 py-2 backdrop-blur-sm">
									<div class="flex items-baseline justify-between gap-1">
										<span class="text-[8px] font-semibold text-ink/55">{size}</span>
										<span class="text-[8.5px] font-semibold text-ink">{amount}</span>
									</div>
									<span class="mt-1.5 block h-[3px] overflow-hidden rounded-full bg-ink/10">
										<span class="block h-full rounded-full bg-ink/55" style={`width:${width}`}></span>
									</span>
								</div>
							))
						}
					</div>

					<p class="relative z-[2] mt-4 max-w-[380px] text-[9.5px] leading-[1.7] text-ink/55">
						For eligible residential systems under the current Tamil Nadu portal's 1–3 kW
						examples. Support is credited through the scheme process.
					</p>
				</article>

				<article class="premium-card grain reveal group flex flex-col p-6 sm:col-span-1 sm:p-7 lg:col-span-2">
					<div class="flex items-start justify-between gap-3">
						<span class="text-[8px] font-semibold uppercase tracking-[0.18em] text-moss/70">03</span>
						<span class="flex h-8 w-8 items-center justify-center rounded-full bg-mint text-forest transition-colors duration-300 group-hover:bg-ink group-hover:text-solar">
							<Icon name="chart" class="h-3.5 w-3.5" />
						</span>
					</div>
					<div class="mt-9">
						<p class="leading-none text-ink">
							<span class="display text-[2.8rem]">1–3</span>
							<span class="ml-1.5 font-sans text-[0.95rem] font-semibold tracking-[0.02em]">kW+</span>
						</p>
						<p class="mt-3 text-[8px] font-semibold uppercase tracking-[0.15em] text-forest">
							System capacity
						</p>
						<p class="mt-3 text-[10.5px] leading-[1.8] text-body">
							Sized around your consumption, roof suitability and how your home uses power.
						</p>
					</div>
					<div class="mt-auto pt-6">
						<div class="h-px w-full bg-ink/10">
							<div class="h-px w-0 bg-solar transition-all duration-500 group-hover:w-2/3"></div>
						</div>
					</div>
				</article>

				<article class="premium-card grain reveal group flex flex-col p-6 sm:col-span-1 sm:p-7 lg:col-span-2">
					<div class="flex items-start justify-between gap-3">
						<span class="text-[8px] font-semibold uppercase tracking-[0.18em] text-moss/70">04</span>
						<span class="flex h-8 w-8 items-center justify-center rounded-full bg-mint text-forest transition-colors duration-300 group-hover:bg-ink group-hover:text-solar">
							<Icon name="sun" class="h-3.5 w-3.5" />
						</span>
					</div>
					<div class="mt-9">
						<p class="leading-none text-ink">
							<span class="display text-[2.8rem]">4–5</span>
							<span class="ml-1.5 font-sans text-[0.95rem] font-semibold tracking-[0.02em]">units*</span>
						</p>
						<p class="mt-3 text-[8px] font-semibold uppercase tracking-[0.15em] text-forest">
							Indicative daily generation per kW
						</p>
						<p class="mt-3 text-[10.5px] leading-[1.8] text-body">
							A rule of thumb. Real output varies with location, season, orientation and
							shading.
						</p>
					</div>
					<div class="mt-auto pt-6">
						<div class="h-px w-full bg-ink/10">
							<div class="h-px w-0 bg-solar transition-all duration-500 group-hover:w-2/3"></div>
						</div>
					</div>
				</article>
			</div>
		</div>

		<div class="mt-8 flex flex-col gap-3 border-t border-ink/10 pt-4 text-[9px] leading-4 text-moss sm:flex-row sm:items-start sm:justify-between">
			<p class="max-w-[630px]">
				*Indicative figures only. Generation, lifespan and subsidy depend on site conditions,
				component warranties and current scheme eligibility.
			</p>
			<p class="shrink-0 text-[8px] uppercase tracking-[0.16em] text-moss/60">NIRT · Solar, understood</p>
		</div>
	</div>

	<div data-popup-trigger class="h-px w-full" aria-hidden="true"></div>
</section>
