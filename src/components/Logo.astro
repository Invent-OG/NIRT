---
interface Props {
	variant?: "dark" | "light";
	class?: string;
	size?: "sm" | "md" | "lg";
}

const { class: className = "", size = "md" } = Astro.props;

const sizes = {
	sm: "h-10 w-auto",
	md: "h-[52px] w-auto sm:h-[64px]",
	lg: "h-20 w-auto sm:h-24",
};

const sizeClass = sizes[size];
---

<a
	href="#home"
	class:list={["group inline-flex shrink-0 items-center", className]}
	aria-label="NIRT Renewable Energy Pvt Ltd — home"
>
	<img
		src="/images/nirt-logo.webp"
		alt="NIRT Renewable Energy Pvt Ltd"
		width="480"
		height="439"
		class:list={[sizeClass, "transition-opacity duration-200 group-hover:opacity-85"]}
	/>
</a>
