---
import HugeIcon from "./HugeIcon.astro";
import { TextAnimate } from "@/registry/magicui/text-animate";

// Solutions data for NIRT
const cards = [
	{
		id: "residential",
		title: "Home rooftop",
		capacity: "1–10 kW",
		copy: "Subsidy-ready rooftop systems for Tamil Nadu homes, sized to your bill and your roof.",
		image: "/images/eco-home-solar.jpg",
		imageAlt: "Home rooftop solar installation",
		link: "#estimate",
	},
	{
		id: "commercial",
		title: "Commercial solar",
		capacity: "10 kW – 1 MW",
		copy: "Rooftop and ground-mount systems for factories, warehouses, schools and institutions.",
		image: "/images/commercial-solar-sunset.jpg",
		imageAlt: "Commercial solar installation for warehouses and factories",
		link: "#estimate",
	},
	{
		id: "utility",
		title: "Solar parks",
		capacity: "MW-scale",
		copy: "Ground-mounted generation and EPC — including NIRT's 15 MW solar park at Harur.",
		image: "/images/solar-park-sunset.jpg",
		imageAlt: "Utility scale ground-mounted solar park",
		link: "#estimate",
	},
];
---

<section
	id="solutions"
	class="relative overflow-hidden bg-blue py-20 text-white sm:py-24 lg:py-28"
>
	<!-- Original background solar park image & blue gradients -->
	<img
		src="/images/project-solar-park.webp"
		alt=""
		width="1100"
		height="688"
		loading="lazy"
		decoding="async"
		class="absolute inset-x-0 bottom-0 h-[62%] w-full object-cover opacity-35"
	/>
	<div
		class="absolute inset-0 bg-[linear-gradient(180deg,#154783_0%,rgba(21,71,131,0.9)_44%,rgba(13,52,99,0.85)_100%)]"
	>
	</div>
	<div
		class="solar-grid-light pointer-events-none absolute inset-0 opacity-[0.14]"
	>
	</div>

	<!-- Scribble accent curve -->
	<svg
		class="pointer-events-none absolute left-[8%] top-[42%] hidden h-[300px] w-[520px] lg:block"
		viewBox="0 0 520 300"
		fill="none"
		aria-hidden="true"
	>
		<path
			class="scribble"
			d="M8 220c60 20 104-42 62-78-38-33-84 18-46 54 48 46 126 8 156-42 26-44-14-80-50-50-34 28-4 84 50 92 64 10 118-42 120-96 2-46-52-56-66-18-14 40 34 78 82 82 58 5 100-34 104-78"
		></path>
	</svg>

	<div class="container-page relative z-10">
		<!-- Section Header -->
		<div
			class="flex items-center justify-between gap-4 border-b border-white/20 pb-4"
		>
			<p class="meta text-white/60">Solutions</p>
			<p class="meta text-white/35">02 / What we build</p>
		</div>

		<div
			class="reveal mt-12 flex flex-col gap-7 lg:flex-row lg:items-end lg:justify-between lg:gap-16"
		>
			<h2
				class="display max-w-[600px] text-[2.6rem] leading-[0.98] text-white sm:text-[3.4rem] lg:text-[4.3rem]"
			>
				<TextAnimate
					client:visible
					text="Join the solar energy revolution."
					animation="blurInUp"
					by="character"
					once
				>
					Join the solar energy revolution.
				</TextAnimate>
			</h2>
			<p class="max-w-[300px] text-[13.5px] leading-[1.8] text-white/65">
				Three ways NIRT puts the sun to work — for a home, a business or the grid.
			</p>
		</div>

		<!-- 3 Overlapping Cards with Website-consistent Typography -->
		<div
			class="relative mt-14 flex flex-col items-center justify-center gap-6 sm:gap-7 md:flex-row md:-space-x-5 lg:-space-x-7 lg:mt-20"
		>
			{
				cards.map((card, index) => (
					<article
						class:list={[
							"reveal group relative flex w-full max-w-[350px] flex-col justify-between overflow-hidden rounded-[28px] sm:rounded-[32px] border border-white/40 bg-[#fcfaf7] text-ink shadow-[0_30px_60px_-25px_rgba(0,0,0,0.45)] transform-gpu transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] hover:z-30 hover:-translate-y-4 hover:rotate-0 hover:shadow-[0_45px_85px_-20px_rgba(0,0,0,0.65)] md:w-[310px] lg:w-[360px] shrink-0",
							index === 0 &&
								"z-10 md:-rotate-[3.5deg] md:translate-y-5",
							index === 1 && "z-20 md:rotate-0 md:-translate-y-1",
							index === 2 &&
								"z-10 md:rotate-[3.5deg] md:translate-y-5",
						]}
					>
						<!-- Top: Solar Image with Soft Bottom Fade & Orange Dot Indicator -->
						<div class="relative h-[220px] w-full overflow-hidden sm:h-[240px]">
							<img
								src={card.image}
								alt={card.imageAlt}
								width="800"
								height="540"
								loading="lazy"
								decoding="async"
								class="h-full w-full object-cover object-center transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-105"
							/>

							<!-- Soft bottom gradient dissolve into card base -->
							<div
								class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-[#fcfaf7] via-[#fcfaf7]/55 to-transparent"
							></div>

							<!-- Orange dot indicator in the top right corner -->
							<div
								class="absolute right-5 top-5 h-2.5 w-2.5 rounded-full bg-yellow-deep shadow-[0_1px_6px_rgba(240,95,35,0.6)]"
								aria-hidden="true"
							></div>
						</div>

						<!-- Bottom: Content Section using consistent site typography -->
						<div class="flex flex-1 flex-col justify-between px-6 pb-6 pt-3 sm:px-7 sm:pb-7">
							<div>
								<h3 class="display text-[1.85rem] sm:text-[2.05rem] leading-none text-ink">
									{card.title}
								</h3>
								<p class="mt-2 text-[11.5px] font-semibold uppercase tracking-[0.14em] text-yellow-deep">
									{card.capacity}
								</p>
								<p class="mt-4 text-[13px] sm:text-[13.5px] leading-[1.7] text-ink/70">
									{card.copy}
								</p>
							</div>

							<!-- Explore bar with arrow icon -->
							<div class="mt-7 flex items-center justify-between border-t border-ink/15 pt-4">
								<a
									href={card.link}
									class="text-[11px] font-bold uppercase tracking-[0.16em] text-ink/60 transition-colors group-hover:text-yellow-deep"
								>
									Explore
								</a>
								<HugeIcon
									name="arrowUpRight"
									class="h-4 w-4 text-ink/40 transition-all duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-yellow-deep"
								/>
							</div>
						</div>
					</article>
				))
			}
		</div>

		<!-- Bottom Sub-Footer Info -->
		<div
			class="relative z-[2] mt-16 flex flex-col gap-4 border-t border-white/20 pt-6 sm:flex-row sm:items-center sm:justify-between"
		>
			<p class="meta text-white/40">Also: energy audits · biogas · O&M</p>
			<a
				href="#estimate"
				class="link-arrow text-yellow hover:text-yellow-light"
			>
				Find the right system
				<HugeIcon name="arrowRight" class="h-4 w-4" />
			</a>
		</div>
	</div>
</section>
