---
import HugeIcon from "./HugeIcon.astro";

const projects = [
	{
		number: "01",
		title: "Industrial Rooftop Solar",
		tag: "Rooftop",
		location: "Tamil Nadu",
		capacity: "On-grid rooftop",
		copy: "An operating rooftop installation from NIRT's commercial portfolio, engineered around the building's existing load and roof structure.",
		image: "/images/project-rooftop.webp",
		alt: "Solar panel array installed across a large industrial rooftop",
		width: 1400,
		height: 875,
	},
	{
		number: "02",
		title: "Solar Park, Harur",
		tag: "Utility-scale",
		location: "Harur, Tamil Nadu",
		capacity: "15 MW",
		copy: "Ground-mounted generation developed as part of NIRT's utility-scale portfolio.",
		image: "/images/project-solar-park.webp",
		alt: "Aerial view of a large ground-mounted solar park",
		width: 1100,
		height: 688,
	},
	{
		number: "03",
		title: "Domestic Rooftop Solar",
		tag: "Residential",
		location: "Tamil Nadu",
		capacity: "3–10 kW",
		copy: "Subsidy-ready residential systems with net-metering guidance.",
		image: "/images/project-residential.webp",
		alt: "Solar panels installed on the tiled roof of a home",
		width: 1400,
		height: 875,
		representative: true,
	},
];
---

<section id="projects" class="relative overflow-hidden bg-navy py-20 text-white sm:py-24 lg:py-28">
	<div class="pointer-events-none absolute -left-40 top-24 h-[420px] w-[420px] rounded-full border border-white/[0.05]"></div>

	<div class="container-page relative">
		<div class="flex items-center justify-between gap-4 border-b border-white/15 pb-4">
			<p class="meta text-white/50">Selected work</p>
			<p class="meta text-white/30">05 / Projects</p>
		</div>

		<div class="mt-12 flex flex-col gap-7 lg:flex-row lg:items-end lg:justify-between lg:gap-16">
			<h2 class="display max-w-[700px] text-[2.6rem] leading-[0.98] text-white sm:text-[3.4rem] lg:text-[4.2rem]">
				Real projects. Measurable capacity.
			</h2>
			<div class="max-w-[310px]">
				<p class="text-[13.5px] leading-[1.8] text-white/55">
					From industrial rooftops to a 15 MW solar park — a look at how NIRT builds across
					Tamil Nadu.
				</p>
				<a href="#estimate" class="link-arrow mt-4 text-yellow hover:text-yellow-light">
					Start with your property
					<HugeIcon name="arrowUpRight" class="h-4 w-4" />
				</a>
			</div>
		</div>

		<div class="mt-11 grid gap-4 lg:grid-cols-12">
			<article class="group relative isolate flex min-h-[420px] flex-col justify-end overflow-hidden bg-teal p-6 sm:min-h-[520px] sm:p-8 lg:col-span-7 lg:min-h-[590px]">
				<img
					src={projects[0].image}
					alt={projects[0].alt}
					width={projects[0].width}
					height={projects[0].height}
					loading="lazy"
					decoding="async"
					class="absolute inset-0 z-0 h-full w-full object-cover transition duration-[1200ms] ease-out group-hover:scale-[1.04]"
				/>
				<div class="absolute inset-0 z-[1] bg-[linear-gradient(0deg,rgba(6,19,28,0.94)_0%,rgba(6,19,28,0.35)_44%,rgba(6,19,28,0.05)_78%,rgba(6,19,28,0.3)_100%)]"></div>

				<div class="absolute left-5 top-5 z-[2] flex flex-wrap gap-2 sm:left-7 sm:top-7">
					<span class="chip chip-dark">Project {projects[0].number}</span>
					<span class="chip chip-dark !border-yellow/40 !text-yellow">{projects[0].tag}</span>
				</div>

				<div class="relative z-[2] max-w-[480px]">
					<p class="meta text-white/45">Flagship installation</p>
					<h3 class="display mt-3 text-[2.2rem] leading-[0.98] text-white sm:text-[2.8rem]">
						{projects[0].title}
					</h3>
					<p class="mt-3 max-w-[420px] text-[12.5px] leading-[1.75] text-white/60">
						{projects[0].copy}
					</p>
					<div class="mt-6 flex flex-wrap gap-x-10 gap-y-3 border-t border-white/15 pt-4">
						<div>
							<p class="meta text-white/35">Location</p>
							<p class="mt-1 text-[12px] text-white/80">{projects[0].location}</p>
						</div>
						<div>
							<p class="meta text-white/35">System</p>
							<p class="mt-1 text-[12px] text-white/80">{projects[0].capacity}</p>
						</div>
					</div>
				</div>

				<span class="absolute bottom-7 right-7 z-[2] hidden h-10 w-10 items-center justify-center border border-white/25 text-yellow transition-transform duration-300 group-hover:-translate-y-1 group-hover:translate-x-1 sm:flex">
					<HugeIcon name="arrowUpRight" class="h-4 w-4" />
				</span>
			</article>

			<div class="grid gap-4 lg:col-span-5">
				{
					projects.slice(1).map((project) => (
						<article class="group relative isolate flex min-h-[270px] flex-col justify-end overflow-hidden bg-teal p-5 text-white sm:min-h-[286px] sm:p-6">
							<img
								src={project.image}
								alt={project.alt}
								width={project.width}
								height={project.height}
								loading="lazy"
								decoding="async"
								class="absolute inset-0 z-0 h-full w-full object-cover transition duration-[1100ms] ease-out group-hover:scale-[1.05]"
							/>
							<div class="absolute inset-0 z-[1] bg-[linear-gradient(0deg,rgba(6,19,28,0.94)_0%,rgba(6,19,28,0.4)_46%,rgba(6,19,28,0.05)_86%)]"></div>

							<div class="absolute left-4 top-4 z-[2] flex flex-wrap gap-2 sm:left-5 sm:top-5">
								<span class="chip chip-dark">{project.tag}</span>
								{project.representative && <span class="meta text-white/40">Representative image</span>}
							</div>

							<div class="relative z-[2]">
								<h3 class="display text-[1.65rem] leading-[1.02] text-white">{project.title}</h3>
								<div class="mt-3 flex items-center justify-between gap-3 border-t border-white/15 pt-3">
									<p class="text-[11px] text-white/55">{project.location}</p>
									<p class="text-[12px] font-medium text-white/90">{project.capacity}</p>
								</div>
							</div>
						</article>
					))
				}
			</div>
		</div>

		<div class="mt-4 flex flex-col gap-2 text-[10.5px] leading-5 text-white/30 sm:flex-row sm:items-center sm:justify-between">
			<p>Project photography from NIRT installations. The residential image is representative.</p>
			<p class="meta">Residential · Commercial · Utility</p>
		</div>
	</div>
</section>
