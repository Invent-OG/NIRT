---
import HugeIcon from "./HugeIcon.astro";

const projects = [
	{
		number: "01",
		title: "Industrial Rooftop Solar",
		tag: "Rooftop",
		location: "Tamil Nadu",
		capacityLabel: "System",
		capacity: "On-grid rooftop",
		copy: "An operating rooftop installation from NIRT's commercial portfolio, engineered around the building's existing load and roof structure.",
		image: "/images/project-rooftop.webp",
		alt: "Solar panel array installed across a large industrial rooftop with trees and a blue building behind it",
		width: 1400,
		height: 875,
	},
	{
		number: "02",
		title: "Solar Park, Harur",
		tag: "Utility-scale",
		location: "Harur, Tamil Nadu",
		capacityLabel: "Installed capacity",
		capacity: "15 MW",
		copy: "Ground-mounted solar generation developed as part of NIRT's utility-scale renewable energy portfolio.",
		image: "/images/project-solar-park.webp",
		alt: "Aerial view of a large ground-mounted solar park with rows of panels",
		width: 1100,
		height: 688,
	},
	{
		number: "03",
		title: "Domestic Rooftop Solar",
		tag: "Residential",
		location: "Tamil Nadu",
		capacityLabel: "Typical capacity",
		capacity: "3–10 kW",
		copy: "Subsidy-ready residential systems with net-metering guidance and support through installation and handover.",
		image: "/images/project-residential.webp",
		alt: "Solar panels installed on the tiled roof of a home under a clear sky",
		width: 1400,
		height: 875,
		representative: true,
	},
];
---

<section id="projects" class="relative overflow-hidden bg-paper py-18 sm:py-22 lg:py-28">
	<div class="pointer-events-none absolute -left-40 top-24 h-[420px] w-[420px] rounded-none border border-navy/[0.05]"></div>
	<div class="pointer-events-none absolute -right-32 bottom-0 h-[360px] w-[360px] rounded-none bg-green/[0.06] blur-3xl"></div>

	<div class="container-page relative">
		<div class="flex flex-col gap-7 lg:flex-row lg:items-end lg:justify-between lg:gap-16">
			<div class="reveal max-w-[680px]">
				<p class="eyebrow text-green">Selected work</p>
				<h2 class="display mt-5 text-[2.5rem] text-navy sm:text-[3.1rem] lg:text-[3.5rem]">
					Real projects. Measurable capacity. <span class="text-green">Local experience.</span>
				</h2>
			</div>
			<div class="reveal flex max-w-[320px] flex-col gap-4 lg:items-end lg:text-right" style="transition-delay:80ms">
				<p class="text-[12px] leading-[1.85] text-body">
					From industrial rooftops to a 15 MW solar park — a look at how NIRT builds across
					Tamil Nadu.
				</p>
				<a href="#estimate" class="link-arrow group text-green">
					Start with your property
					<HugeIcon name="arrowUpRight" class="h-3.5 w-3.5" />
				</a>
			</div>
		</div>

		<div class="mt-10 grid gap-4 lg:mt-12 lg:grid-cols-12">
			<div class="lg:col-span-7">
				{
					projects.slice(0, 1).map((project) => (
						<article class="grain grain-dark group relative isolate flex min-h-[440px] flex-col justify-end overflow-hidden rounded-none bg-navy p-6 text-white sm:min-h-[520px] sm:p-8 lg:min-h-[580px]">
							<img
								src={project.image}
								alt={project.alt}
								width={project.width}
								height={project.height}
								loading="lazy"
								decoding="async"
								class="absolute inset-0 z-0 h-full w-full object-cover transition duration-[1200ms] ease-out group-hover:scale-[1.04]"
							/>
							<div class="absolute inset-0 z-[1] bg-[linear-gradient(0deg,rgba(7,27,60,0.96)_0%,rgba(7,27,60,0.46)_42%,rgba(7,27,60,0.05)_74%,rgba(7,27,60,0.3)_100%)]"></div>

							<div class="absolute left-5 top-5 z-[2] flex flex-wrap items-center gap-2 sm:left-7 sm:top-7">
								<span class="rounded-none border border-white/20 bg-white/10 px-2.5 py-1.5 text-[7.5px] font-semibold uppercase tracking-[0.13em] text-white/80 backdrop-blur-md">
									Project {project.number}
								</span>
								<span class="rounded-none border border-green/30 bg-green/20 px-2.5 py-1.5 text-[7.5px] font-semibold uppercase tracking-[0.13em] text-white backdrop-blur-md">
									{project.tag}
								</span>
							</div>

							<div class="relative z-[2] max-w-[520px]">
								<p class="text-[8px] font-semibold uppercase tracking-[0.18em] text-green-mid">
									Flagship installation
								</p>
								<h3 class="display mt-3 text-[2.3rem] leading-[0.98] text-white sm:text-[2.9rem]">
									{project.title}
								</h3>
								<p class="mt-3 max-w-[430px] text-[10.5px] leading-[1.8] text-white/65">
									{project.copy}
								</p>

								<dl class="mt-6 flex flex-wrap gap-x-10 gap-y-4 border-t border-white/15 pt-4">
									<div>
										<dt class="text-[7px] font-semibold uppercase tracking-[0.16em] text-white/40">Location</dt>
										<dd class="mt-1 text-[10px] font-medium text-white/80">{project.location}</dd>
									</div>
									<div>
										<dt class="text-[7px] font-semibold uppercase tracking-[0.16em] text-white/40">{project.capacityLabel}</dt>
										<dd class="mt-1 text-[10px] font-medium text-white/80">{project.capacity}</dd>
									</div>
								</dl>
							</div>

							<span class="pointer-events-none absolute bottom-8 right-8 z-[2] hidden h-12 w-12 items-center justify-center rounded-none border border-white/20 bg-white/10 text-orange backdrop-blur-md transition-transform duration-300 group-hover:rotate-45 sm:flex">
								<HugeIcon name="arrowUpRight" class="h-5 w-5" />
							</span>
						</article>
					))
				}
			</div>

			<div class="grid gap-4 lg:col-span-5">
				{
					projects.slice(1).map((project) => (
						<article class="grain grain-dark group relative isolate flex min-h-[270px] flex-col justify-end overflow-hidden rounded-none bg-navy p-5 text-white sm:min-h-[290px] sm:p-6 lg:min-h-0">
							<img
								src={project.image}
								alt={project.alt}
								width={project.width}
								height={project.height}
								loading="lazy"
								decoding="async"
								class="absolute inset-0 z-0 h-full w-full object-cover transition duration-[1100ms] ease-out group-hover:scale-[1.05]"
							/>
							<div class="absolute inset-0 z-[1] bg-[linear-gradient(0deg,rgba(7,27,60,0.96)_0%,rgba(7,27,60,0.5)_40%,rgba(7,27,60,0.05)_80%)]"></div>

							<div class="absolute left-4 top-4 z-[2] flex flex-wrap items-center gap-2 sm:left-5 sm:top-5">
								<span class="rounded-none border border-white/20 bg-white/10 px-2 py-1 text-[7px] font-semibold uppercase tracking-[0.12em] text-white/80 backdrop-blur-md">
									{project.tag}
								</span>
								{project.representative && (
									<span class="rounded-none border border-white/15 bg-white/10 px-2 py-1 text-[6.5px] font-medium uppercase tracking-[0.1em] text-white/55 backdrop-blur-md">
										Representative image
									</span>
								)}
							</div>

							<div class="relative z-[2]">
								<div class="flex items-end justify-between gap-4">
									<h3 class="display text-[1.6rem] leading-[1.02] text-white sm:text-[1.8rem]">
										{project.title}
									</h3>
									<span class="mb-1 flex h-7 w-7 shrink-0 items-center justify-center rounded-none border border-white/20 bg-white/10 text-[7.5px] font-semibold text-white/70 backdrop-blur-md">
										{project.number}
									</span>
								</div>
								<div class="mt-3 flex items-center justify-between gap-4 border-t border-white/15 pt-3">
									<p class="text-[8.5px] font-medium text-white/60">{project.location}</p>
									<p class="text-[8.5px] font-semibold text-white/85">{project.capacity}</p>
								</div>
							</div>
						</article>
					))
				}
			</div>

			<div class="edge-brand-dark grain grain-dark relative overflow-hidden rounded-none bg-navy p-6 text-white sm:p-8 lg:col-span-12 lg:px-10 lg:py-8">
				<div class="solar-grid-light pointer-events-none absolute inset-0 opacity-20"></div>
				<div class="pointer-events-none absolute -right-20 -top-24 h-64 w-64 rounded-none bg-orange/[0.16] blur-3xl"></div>

				<div class="relative z-[2] flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between lg:gap-10">
					<div class="flex items-start gap-4">
						<span class="icon-tile icon-tile-navy hidden h-12 w-12 shrink-0 rounded-none text-orange sm:flex">
							<HugeIcon name="homeSolar" class="h-6 w-6" />
						</span>
						<div class="max-w-[540px]">
							<p class="eyebrow text-orange-light">Your project next</p>
							<h3 class="display mt-3 text-[1.8rem] leading-[1.02] text-white sm:text-[2.15rem]">
								Every roof has a different energy story.
							</h3>
							<p class="mt-3 max-w-[440px] text-[10.5px] leading-[1.8] text-white/55 md:hidden">
								Share your location and consumption. We'll assess the site, size the system
								and explain the numbers before you commit.
							</p>
						</div>
					</div>
					<p class="hidden max-w-[300px] text-[10.5px] leading-[1.8] text-white/50 md:block">
						Share your location and consumption. We'll assess the site, size the system and
						explain the numbers before you commit.
					</p>
					<a href="#estimate" class="btn-primary shrink-0 self-start lg:self-auto">
						Discuss your project
						<HugeIcon name="arrowRight" class="h-4 w-4" />
					</a>
				</div>
			</div>
		</div>

		<p class="mt-4 text-[9px] leading-4 text-moss">
			Project photography from NIRT installations. The residential image is representative.
		</p>
	</div>
</section>
