---
import HugeIcon from "./HugeIcon.astro";

interface Props {
	idPrefix: string;
	buttonLabel?: string;
	source?: string;
}

const { idPrefix, buttonLabel = "Get My Free Estimate", source = "hero" } = Astro.props;

const districts = [
	"Ariyalur",
	"Chengalpattu",
	"Chennai",
	"Coimbatore",
	"Cuddalore",
	"Dharmapuri",
	"Dindigul",
	"Erode",
	"Kallakurichi",
	"Kancheepuram",
	"Kanyakumari",
	"Karur",
	"Krishnagiri",
	"Madurai",
	"Mayiladuthurai",
	"Nagapattinam",
	"Namakkal",
	"Nilgiris",
	"Perambalur",
	"Pudukkottai",
	"Ramanathapuram",
	"Ranipet",
	"Salem",
	"Sivaganga",
	"Tenkasi",
	"Thanjavur",
	"Theni",
	"Thoothukudi",
	"Tiruchirappalli",
	"Tirunelveli",
	"Tirupathur",
	"Tiruppur",
	"Tiruvallur",
	"Tiruvannamalai",
	"Tiruvarur",
	"Vellore",
	"Viluppuram",
	"Virudhunagar",
	"Other / outside Tamil Nadu",
];

const billOptions = [
	"Less than ₹1500",
	"₹1500 – ₹2500",
	"₹2500 – ₹4000",
	"₹4000 – ₹8000",
	"More than ₹8000",
];
---

<div data-lead-form-shell>
	<form data-lead-form data-source={source} novalidate>
		<div class="grid gap-3.5 sm:grid-cols-2">
			<div>
				<label for={`${idPrefix}-name`} class="field-label">
					Full name <span class="text-orange-deep">*</span>
				</label>
				<input
					id={`${idPrefix}-name`}
					name="name"
					type="text"
					required
					maxlength="80"
					autocomplete="name"
					placeholder="Your name"
					class="field-control"
				/>
			</div>

			<div>
				<label for={`${idPrefix}-contact`} class="field-label">
					Mobile number <span class="text-orange-deep">*</span>
				</label>
				<input
					id={`${idPrefix}-contact`}
					name="contact"
					type="tel"
					required
					inputmode="numeric"
					pattern="[6-9][0-9]{9}"
					maxlength="10"
					autocomplete="tel-national"
					title="Enter a 10-digit Indian mobile number"
					placeholder="10-digit number"
					class="field-control"
				/>
			</div>

			<div class="sm:col-span-2">
				<label for={`${idPrefix}-district`} class="field-label">
					District <span class="text-orange-deep">*</span>
				</label>
				<div class="relative">
					<select
						id={`${idPrefix}-district`}
						name="district"
						required
						autocomplete="address-level1"
						class="field-control cursor-pointer appearance-none pr-9"
					>
						<option value="" selected disabled>Select district</option>
						{districts.map((district) => <option value={district}>{district}</option>)}
					</select>
					<HugeIcon
						name="arrowDown"
						class="pointer-events-none absolute right-3 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-moss"
					/>
				</div>
			</div>

			<div class="sm:col-span-2">
				<div class="flex items-center gap-1.5 mb-2">
					<label class="field-label !mb-0 cursor-default">
						Monthly Electricity Bill <span class="text-orange-deep">*</span>
					</label>
					<span
						class="inline-flex text-body/50 hover:text-ink transition-colors cursor-help"
						title="Select your average monthly electricity bill to calculate required solar plant size"
						aria-label="Electricity bill info"
					>
						<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="10"></circle>
							<line x1="12" y1="16" x2="12" y2="12"></line>
							<line x1="12" y1="8" x2="12.01" y2="8"></line>
						</svg>
					</span>
				</div>

				<div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
					{billOptions.map((option) => (
						<label class="group relative cursor-pointer select-none">
							<input
								type="radio"
								name="bill"
								value={option}
								required
								class="peer sr-only"
							/>
							<span
								class="flex h-11 sm:h-12 w-full items-center justify-center rounded-xl border border-line bg-[#fffdf7] px-2 text-center text-[12.5px] sm:text-[13px] font-medium text-ink transition-all duration-150 hover:border-[#b9b09b] peer-focus-visible:border-ink peer-focus-visible:shadow-[inset_0_-2px_0_var(--color-yellow)] peer-checked:border-ink peer-checked:bg-white peer-checked:font-semibold peer-checked:shadow-[inset_0_-2px_0_var(--color-yellow)]"
							>
								{option}
							</span>
						</label>
					))}
				</div>
			</div>

			<div class="sm:col-span-2">
				<input type="hidden" name="source" value={source} />
				<!-- Honeypot for spam bots -->
				<div class="hidden" aria-hidden="true">
					<input type="text" name="company_hp" tabindex="-1" autocomplete="off" />
				</div>

				<button
					type="submit"
					class="btn-primary w-full disabled:cursor-not-allowed disabled:opacity-75 transition-all"
					data-submit-btn
				>
					<span class="inline-flex items-center gap-2" data-submit-idle>
						<HugeIcon name="sun" class="h-4 w-4" />
						{buttonLabel}
						<HugeIcon name="arrowRight" class="h-4 w-4" />
					</span>
					<span class="hidden inline-flex items-center gap-2" data-submit-loading>
						<svg class="h-4 w-4 animate-spin text-current" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
							<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
						</svg>
						Submitting to advisor...
					</span>
				</button>

				<!-- Error Banner -->
				<div
					class="hidden mt-3 rounded-xl border border-red-200 bg-red-50 p-3 text-[12px] text-red-700"
					data-lead-error
					role="alert"
				>
					<p data-error-text>Unable to submit your enquiry. Please try again.</p>
				</div>
			</div>
		</div>

		<div class="mt-4 flex items-start gap-2 text-[11px] leading-[1.6] text-body/75">
			<HugeIcon name="shieldCheck" class="mt-0.5 h-3.5 w-3.5 shrink-0 text-green" />
			<p>
				Your details stay private. By submitting, you agree to be contacted by NIRT about your
				solar assessment. No spam, no obligation.
			</p>
		</div>
	</form>

	<div class="hidden py-6 text-center" data-lead-success>
		<div class="relative mx-auto flex h-14 w-14 items-center justify-center rounded-2xl border border-green/25 bg-green-soft text-green">
			<span class="absolute inset-[-6px] rounded-2xl border border-green/15" aria-hidden="true"></span>
			<HugeIcon name="checkCircle" class="h-7 w-7" />
		</div>
		<h3 class="display mt-5 text-[1.6rem] text-navy" tabindex="-1">Request received.</h3>
		<p class="mx-auto mt-2 max-w-[290px] text-[13px] leading-6 text-body" data-success-copy>
			Thank you. Our team will contact you shortly about your solar assessment.
		</p>
		<button type="button" class="btn-outline mt-5 !min-h-10 !text-[11.5px]" data-lead-reset>
			Submit another enquiry
		</button>
	</div>
</div>

<script>
	const forms = document.querySelectorAll<HTMLFormElement>("[data-lead-form]");

	forms.forEach((form) => {
		const shell = form.closest<HTMLElement>("[data-lead-form-shell]");
		const success = shell?.querySelector<HTMLElement>("[data-lead-success]");
		const successCopy = shell?.querySelector<HTMLElement>("[data-success-copy]");
		const reset = shell?.querySelector<HTMLButtonElement>("[data-lead-reset]");
		const submitBtn = form.querySelector<HTMLButtonElement>("[data-submit-btn]");
		const submitIdle = form.querySelector<HTMLElement>("[data-submit-idle]");
		const submitLoading = form.querySelector<HTMLElement>("[data-submit-loading]");
		const errorEl = form.querySelector<HTMLElement>("[data-lead-error]");
		const errorText = form.querySelector<HTMLElement>("[data-error-text]");

		let isSubmitting = false;

		form.addEventListener("submit", async (event) => {
			event.preventDefault();

			// Hide any existing error
			errorEl?.classList.add("hidden");

			if (!form.checkValidity()) {
				form.reportValidity();
				return;
			}

			if (isSubmitting) return;
			isSubmitting = true;

			// UI loading state
			if (submitBtn) submitBtn.disabled = true;
			submitIdle?.classList.add("hidden");
			submitLoading?.classList.remove("hidden");

			try {
				const formData = new FormData(form);
				const payload = Object.fromEntries(formData.entries());

				const response = await fetch("/api/estimate", {
					method: "POST",
					headers: {
						"Content-Type": "application/json",
						"Accept": "application/json",
					},
					body: JSON.stringify(payload),
				});

				const data = await response.json().catch(() => ({}));

				if (!response.ok || !data.success) {
					throw new Error(data.error || "Unable to submit your enquiry. Please try again.");
				}

				// Only show success after server confirmation
				const name = (form.elements.namedItem("name") as HTMLInputElement | null)?.value.trim();
				if (successCopy && name) {
					successCopy.textContent = `Thank you, ${name}. Our team will contact you shortly about your solar assessment.`;
				}

				form.reset();
				form.classList.add("hidden");
				success?.classList.remove("hidden");
				success?.querySelector<HTMLElement>("h3")?.focus();
			} catch (err: any) {
				if (errorText) {
					errorText.textContent = err.message || "Failed to submit enquiry. Please call +91 96550 46464 directly.";
				}
				errorEl?.classList.remove("hidden");
			} finally {
				isSubmitting = false;
				if (submitBtn) submitBtn.disabled = false;
				submitIdle?.classList.remove("hidden");
				submitLoading?.classList.add("hidden");
			}
		});

		reset?.addEventListener("click", () => {
			errorEl?.classList.add("hidden");
			success?.classList.add("hidden");
			form.classList.remove("hidden");
			form.querySelector<HTMLInputElement>('input[name="name"]')?.focus();
		});
	});
</script>
