---
interface Props {
	idPrefix: string;
	buttonLabel?: string;
	source?: string;
}

const { idPrefix, buttonLabel = "Get My Solar Estimate", source = "hero" } = Astro.props;

const districts = [
	"Ariyalur",
	"Chengalpattu",
	"Chennai",
	"Coimbatore",
	"Cuddalore",
	"Dharmapuri",
	"Dindigul",
	"Erode",
	"Kallakurichi",
	"Kancheepuram",
	"Kanyakumari",
	"Karur",
	"Krishnagiri",
	"Madurai",
	"Mayiladuthurai",
	"Nagapattinam",
	"Namakkal",
	"Nilgiris",
	"Perambalur",
	"Pudukkottai",
	"Ramanathapuram",
	"Ranipet",
	"Salem",
	"Sivaganga",
	"Tenkasi",
	"Thanjavur",
	"Theni",
	"Thoothukudi",
	"Tiruchirappalli",
	"Tirunelveli",
	"Tirupathur",
	"Tiruppur",
	"Tiruvallur",
	"Tiruvannamalai",
	"Tiruvarur",
	"Vellore",
	"Viluppuram",
	"Virudhunagar",
	"Other / outside Tamil Nadu",
];

const billOptions = [
	"Less than ₹1,000",
	"₹1,000 – ₹2,000",
	"₹2,000 – ₹4,000",
	"₹4,000 – ₹6,000",
	"₹6,000 – ₹10,000",
	"Above ₹10,000",
];
---

<div data-lead-form-shell>
	<form data-lead-form data-source={source} novalidate>
		<div class="grid gap-3.5 sm:grid-cols-2">
			<div>
				<label for={`${idPrefix}-name`} class="field-label">
					Name <span class="text-solar-deep">*</span>
				</label>
				<input
					id={`${idPrefix}-name`}
					name="name"
					type="text"
					required
					maxlength="80"
					autocomplete="name"
					placeholder="Your full name"
					class="field-control"
				/>
			</div>

			<div>
				<label for={`${idPrefix}-district`} class="field-label">
					District <span class="text-solar-deep">*</span>
				</label>
				<div class="relative">
					<select
						id={`${idPrefix}-district`}
						name="district"
						required
						autocomplete="address-level1"
						class="field-control cursor-pointer appearance-none pr-9"
					>
						<option value="" selected disabled>Select district</option>
						{districts.map((district) => <option value={district}>{district}</option>)}
					</select>
					<svg
						class="pointer-events-none absolute right-3 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-moss"
						viewBox="0 0 16 16"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						aria-hidden="true"
					>
						<path d="m4 6 4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</div>
			</div>

			<div>
				<label for={`${idPrefix}-contact`} class="field-label">
					Contact number <span class="text-solar-deep">*</span>
				</label>
				<input
					id={`${idPrefix}-contact`}
					name="contact"
					type="tel"
					required
					inputmode="numeric"
					pattern="[6-9][0-9]{9}"
					maxlength="10"
					autocomplete="tel-national"
					title="Enter a 10-digit Indian mobile number"
					placeholder="10-digit mobile number"
					class="field-control"
				/>
			</div>

			<div>
				<label for={`${idPrefix}-bill`} class="field-label">
					Bi-monthly bill <span class="text-solar-deep">*</span>
				</label>
				<div class="relative">
					<select
						id={`${idPrefix}-bill`}
						name="bill"
						required
						class="field-control cursor-pointer appearance-none pr-9"
					>
						<option value="" selected disabled>Select bill range</option>
						{billOptions.map((option) => <option value={option}>{option}</option>)}
					</select>
					<svg
						class="pointer-events-none absolute right-3 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-moss"
						viewBox="0 0 16 16"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						aria-hidden="true"
					>
						<path d="m4 6 4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</div>
			</div>

			<div class="sm:col-span-2">
				<input type="hidden" name="source" value={source} />					<button type="submit" class="btn-solar w-full">
						<span class="text-[12px] leading-none opacity-70" aria-hidden="true">✦</span>
						{buttonLabel}
						<svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
							<path d="M2.5 8h10M8.5 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</button>
			</div>
		</div>

		<p class="mt-3 flex items-start gap-1.5 text-[9px] leading-4 text-moss">
			<svg class="mt-0.5 h-3 w-3 shrink-0 text-forest/70" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
				<rect x="3" y="7" width="10" height="7" rx="1.8" />
				<path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" stroke-linecap="round" />
			</svg>
			Your details stay private. By submitting, you agree to be contacted by NIRT about your
			solar assessment.
		</p>
	</form>

	<div class="hidden py-6 text-center" data-lead-success>
		<div class="relative mx-auto flex h-14 w-14 items-center justify-center rounded-full border border-solar/40 bg-solar/15 text-forest">
			<span class="absolute inset-[-6px] rounded-full border border-solar/15" aria-hidden="true"></span>
			<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
				<path d="m5 12.5 4.5 4.5L19 7.5" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
		</div>
		<h3 class="display mt-5 text-[1.65rem] text-ink" tabindex="-1">Request received.</h3>
		<p class="mx-auto mt-2 max-w-[290px] text-[11.5px] leading-5 text-body" data-success-copy>
			Thank you. Our team will contact you shortly about your solar assessment.
		</p>
		<button type="button" class="btn-outline mt-5 !min-h-10 text-[10.5px]" data-lead-reset>
			Submit another enquiry
		</button>
	</div>
</div>

<script>
	const forms = document.querySelectorAll<HTMLFormElement>("[data-lead-form]");

	forms.forEach((form) => {
		const shell = form.closest<HTMLElement>("[data-lead-form-shell]");
		const success = shell?.querySelector<HTMLElement>("[data-lead-success]");
		const successCopy = shell?.querySelector<HTMLElement>("[data-success-copy]");
		const reset = shell?.querySelector<HTMLButtonElement>("[data-lead-reset]");

		form.addEventListener("submit", (event) => {
			event.preventDefault();

			if (!form.checkValidity()) {
				form.reportValidity();
				return;
			}

			const name = (form.elements.namedItem("name") as HTMLInputElement | null)?.value.trim();
			if (successCopy && name) {
				successCopy.textContent = `Thank you, ${name}. Our team will contact you shortly about your solar assessment.`;
			}

			form.classList.add("hidden");
			success?.classList.remove("hidden");
			success?.querySelector<HTMLElement>("h3")?.focus();
			form.reset();
		});

		reset?.addEventListener("click", () => {
			success?.classList.add("hidden");
			form.classList.remove("hidden");
			form.querySelector<HTMLInputElement>('input[name="name"]')?.focus();
		});
	});
</script>
