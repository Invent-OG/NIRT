---
import HugeIcon from "./HugeIcon.astro";

interface Props {
	idPrefix: string;
	buttonLabel?: string;
	source?: string;
}

const { idPrefix, buttonLabel = "Get My Free Estimate", source = "hero" } = Astro.props;

const districts = [
	"Ariyalur",
	"Chengalpattu",
	"Chennai",
	"Coimbatore",
	"Cuddalore",
	"Dharmapuri",
	"Dindigul",
	"Erode",
	"Kallakurichi",
	"Kancheepuram",
	"Kanyakumari",
	"Karur",
	"Krishnagiri",
	"Madurai",
	"Mayiladuthurai",
	"Nagapattinam",
	"Namakkal",
	"Nilgiris",
	"Perambalur",
	"Pudukkottai",
	"Ramanathapuram",
	"Ranipet",
	"Salem",
	"Sivaganga",
	"Tenkasi",
	"Thanjavur",
	"Theni",
	"Thoothukudi",
	"Tiruchirappalli",
	"Tirunelveli",
	"Tirupathur",
	"Tiruppur",
	"Tiruvallur",
	"Tiruvannamalai",
	"Tiruvarur",
	"Vellore",
	"Viluppuram",
	"Virudhunagar",
	"Other / outside Tamil Nadu",
];

const billOptions = [
	"Less than ₹1,000",
	"₹1,000 – ₹2,000",
	"₹2,000 – ₹4,000",
	"₹4,000 – ₹6,000",
	"₹6,000 – ₹10,000",
	"Above ₹10,000",
];
---

<div data-lead-form-shell>
	<form data-lead-form data-source={source} novalidate>
		<div class="grid gap-3.5 sm:grid-cols-2">
			<div>
				<label for={`${idPrefix}-name`} class="field-label">
					Full name <span class="text-orange-deep">*</span>
				</label>
				<input
					id={`${idPrefix}-name`}
					name="name"
					type="text"
					required
					maxlength="80"
					autocomplete="name"
					placeholder="Your name"
					class="field-control"
				/>
			</div>

			<div>
				<label for={`${idPrefix}-contact`} class="field-label">
					Mobile number <span class="text-orange-deep">*</span>
				</label>
				<input
					id={`${idPrefix}-contact`}
					name="contact"
					type="tel"
					required
					inputmode="numeric"
					pattern="[6-9][0-9]{9}"
					maxlength="10"
					autocomplete="tel-national"
					title="Enter a 10-digit Indian mobile number"
					placeholder="10-digit number"
					class="field-control"
				/>
			</div>

			<div>
				<label for={`${idPrefix}-district`} class="field-label">
					District <span class="text-orange-deep">*</span>
				</label>
				<div class="relative">
					<select
						id={`${idPrefix}-district`}
						name="district"
						required
						autocomplete="address-level1"
						class="field-control cursor-pointer appearance-none pr-9"
					>
						<option value="" selected disabled>Select district</option>
						{districts.map((district) => <option value={district}>{district}</option>)}
					</select>
					<HugeIcon
						name="arrowDown"
						class="pointer-events-none absolute right-3 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-moss"
					/>
				</div>
			</div>

			<div>
				<label for={`${idPrefix}-bill`} class="field-label">
					Bi-monthly bill <span class="text-orange-deep">*</span>
				</label>
				<div class="relative">
					<select
						id={`${idPrefix}-bill`}
						name="bill"
						required
						class="field-control cursor-pointer appearance-none pr-9"
					>
						<option value="" selected disabled>Select bill range</option>
						{billOptions.map((option) => <option value={option}>{option}</option>)}
					</select>
					<HugeIcon
						name="arrowDown"
						class="pointer-events-none absolute right-3 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-moss"
					/>
				</div>
			</div>

			<div class="sm:col-span-2">
				<input type="hidden" name="source" value={source} />
				<button type="submit" class="btn-primary w-full">
					<HugeIcon name="sun" class="h-4 w-4" />
					{buttonLabel}
					<HugeIcon name="arrowRight" class="h-4 w-4" />
				</button>
			</div>
		</div>

		<div class="mt-3 flex items-start gap-1.5 text-[9px] leading-4 text-moss">
			<HugeIcon name="shieldCheck" class="mt-0.5 h-3 w-3 shrink-0 text-green" />
			<p>
				Your details stay private. By submitting, you agree to be contacted by NIRT about your
				solar assessment. No spam, no obligation.
			</p>
		</div>
	</form>

	<div class="hidden py-6 text-center" data-lead-success>
		<div class="relative mx-auto flex h-14 w-14 items-center justify-center rounded-none border border-green/25 bg-green-soft text-green">
			<span class="absolute inset-[-6px] rounded-none border border-green/15" aria-hidden="true"></span>
			<HugeIcon name="checkCircle" class="h-7 w-7" />
		</div>
		<h3 class="display mt-5 text-[1.6rem] text-navy" tabindex="-1">Request received.</h3>
		<p class="mx-auto mt-2 max-w-[290px] text-[11.5px] leading-5 text-body" data-success-copy>
			Thank you. Our team will contact you shortly about your solar assessment.
		</p>
		<button type="button" class="btn-outline mt-5 !min-h-10 text-[10.5px]" data-lead-reset>
			Submit another enquiry
		</button>
	</div>
</div>

<script>
	const forms = document.querySelectorAll<HTMLFormElement>("[data-lead-form]");

	forms.forEach((form) => {
		const shell = form.closest<HTMLElement>("[data-lead-form-shell]");
		const success = shell?.querySelector<HTMLElement>("[data-lead-success]");
		const successCopy = shell?.querySelector<HTMLElement>("[data-success-copy]");
		const reset = shell?.querySelector<HTMLButtonElement>("[data-lead-reset]");

		form.addEventListener("submit", (event) => {
			event.preventDefault();

			if (!form.checkValidity()) {
				form.reportValidity();
				return;
			}

			const name = (form.elements.namedItem("name") as HTMLInputElement | null)?.value.trim();
			if (successCopy && name) {
				successCopy.textContent = `Thank you, ${name}. Our team will contact you shortly about your solar assessment.`;
			}

			form.classList.add("hidden");
			success?.classList.remove("hidden");
			success?.querySelector<HTMLElement>("h3")?.focus();
			form.reset();
		});

		reset?.addEventListener("click", () => {
			success?.classList.add("hidden");
			form.classList.remove("hidden");
			form.querySelector<HTMLInputElement>('input[name="name"]')?.focus();
		});
	});
</script>
