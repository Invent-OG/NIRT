---
import { icons, type IconName } from "../icons";

interface Props {
	name: IconName;
	class?: string;
	strokeWidth?: number;
	ariaLabel?: string;
}

const { name, class: className = "h-5 w-5", strokeWidth = 1.6, ariaLabel } = Astro.props;

const icon = icons[name];

const kebab = (key: string) => key.replace(/([A-Z])/g, "-$1").toLowerCase();

const markup = icon
	.map(([tag, attrs]) => {
		const clean = Object.entries(attrs)
			.filter(([key]) => key !== "key" && key !== "strokeWidth")
			.map(([key, value]) => `${kebab(key)}="${value}"`)
			.join(" ");
		return `<${tag} ${clean} />`;
	})
	.join("");
---

<svg
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width={strokeWidth}
	stroke-linecap="round"
	stroke-linejoin="round"
	class={className}
	aria-hidden={ariaLabel ? undefined : "true"}
	role={ariaLabel ? "img" : undefined}
	aria-label={ariaLabel}
	set:html={markup}
/>
