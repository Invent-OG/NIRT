---
import HugeIcon from "./HugeIcon.astro";
---

<section class="relative isolate overflow-hidden bg-paper py-16 sm:py-20 lg:py-24" aria-labelledby="final-cta-heading">
	<div class="pointer-events-none absolute left-1/2 top-0 h-[320px] w-[520px] -translate-x-1/2 rounded-none bg-green/[0.08] blur-3xl"></div>
	<div class="solar-grid pointer-events-none absolute inset-x-0 bottom-0 h-[45%] opacity-40 [mask-image:linear-gradient(0deg,black,transparent)]"></div>

	<div class="container-page relative">
		<div class="edge-brand-dark relative overflow-hidden rounded-none p-[1px] shadow-[0_45px_100px_-45px_rgba(7,27,60,0.65)]">
			<div class="relative grid overflow-hidden rounded-none bg-navy-dark lg:grid-cols-[1.02fr_0.98fr]">
				<div class="relative z-[2] overflow-hidden px-6 py-10 text-white sm:px-9 sm:py-12 lg:px-11 lg:py-14 xl:px-14">
					<div class="aurora opacity-30"></div>
					<div class="solar-grid-light pointer-events-none absolute inset-0 opacity-20"></div>
					<div class="pointer-events-none absolute -left-20 -top-24 h-64 w-64 rounded-none border border-orange/20"></div>

					<div class="relative z-[2] max-w-[510px]">
						<p class="eyebrow text-orange-light">Ready when you are</p>
						<h2 id="final-cta-heading" class="display mt-5 text-[2.7rem] leading-[0.98] text-white sm:text-[3.3rem] lg:text-[3.55rem]">
							Start with a <span class="text-green-mid">solar assessment.</span>
						</h2>
						<p class="mt-5 max-w-[430px] text-[12.5px] leading-[1.9] text-white/60 sm:text-[13.5px]">
							Tell us where you are and how you use power. We'll help you understand the right
							system, the subsidy and the investment — before you decide.
						</p>

						<div class="mt-8 flex flex-wrap items-center gap-3">
							<a href="#estimate" class="btn-primary">
								Get my solar estimate
								<HugeIcon name="arrowRight" class="h-4 w-4" />
							</a>
							<a href="tel:+919655046464" class="btn-glass group">
								<HugeIcon name="phone" class="h-4 w-4 text-green-mid" />
								+91 96550 46464
							</a>
						</div>

						<div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-white/10 pt-4 text-[8.5px] leading-4 text-white/40">
							<span class="flex items-center gap-1.5">
								<HugeIcon name="mapPin" class="h-3 w-3 text-orange" />
								Salem, Tamil Nadu
							</span>
							<span class="flex items-center gap-1.5">
								<HugeIcon name="clock" class="h-3 w-3 text-green-mid" />
								Mon–Sat · 9am–6pm
							</span>
							<span class="flex items-center gap-1.5">
								<HugeIcon name="shieldCheck" class="h-3 w-3 text-white/50" />
								No obligation
							</span>
						</div>
					</div>
				</div>

				<div class="relative min-h-[340px] overflow-hidden lg:min-h-[460px]">
					<img
						src="/images/cta-consultation.webp"
						alt="An engineer and a homeowner reviewing a solar plan beside a solar array"
						width="1800"
						height="1012"
						loading="lazy"
						decoding="async"
						class="absolute inset-0 h-full w-full object-cover object-[58%_32%]"
					/>
					<div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(7,27,60,0.9)_0%,rgba(7,27,60,0.12)_45%,rgba(7,27,60,0.16)_100%)]"></div>
					<div class="absolute inset-0 bg-[linear-gradient(0deg,rgba(7,27,60,0.85)_0%,rgba(7,27,60,0)_48%)]"></div>

					<div class="absolute bottom-4 left-4 right-4 rounded-none border border-white/20 bg-navy-dark/65 p-4 backdrop-blur-xl sm:bottom-5 sm:left-5 sm:right-5 sm:p-5">
						<p class="flex items-center gap-2 text-[8px] font-semibold uppercase tracking-[0.16em] text-orange-light">
							<span class="h-1.5 w-1.5 rounded-none bg-orange" aria-hidden="true"></span>
							What happens next
						</p>
						<ol class="mt-3 grid gap-2.5">
							{
								[
									["01", "A quick call about your roof and bill"],
									["02", "A site assessment at your convenience"],
									["03", "A clear proposal, with the numbers"],
								].map(([number, text]) => (
									<li class="flex items-start gap-2.5 text-[9.5px] leading-[1.5] text-white/70">
										<span class="mt-px text-[7px] font-semibold tracking-[0.1em] text-green-mid">{number}</span>
										{text}
									</li>
								))
							}
						</ol>
						<p class="mt-3 border-t border-white/10 pt-2.5 text-[8px] text-white/40">
							No pressure. No obligation.
						</p>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
