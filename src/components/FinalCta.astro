---
import Icon from "./Icon.astro";
---

<section class="relative isolate overflow-hidden bg-paper py-16 sm:py-20 lg:py-24" aria-labelledby="final-cta-heading">
	<div class="pointer-events-none absolute left-1/2 top-0 h-[320px] w-[520px] -translate-x-1/2 rounded-full bg-solar/[0.08] blur-3xl"></div>

	<div class="container-page relative">
		<div class="edge-gold-dark relative overflow-hidden rounded-[32px] p-[1px] shadow-[0_45px_100px_-45px_rgba(8,31,27,0.7)]">
			<div class="relative grid overflow-hidden rounded-[31px] bg-ink lg:grid-cols-[1.05fr_0.95fr]">
				<div class="relative z-[2] overflow-hidden px-6 py-10 text-paper sm:px-9 sm:py-12 lg:px-11 lg:py-14 xl:px-14">
					<div class="aurora opacity-25"></div>
					<div class="solar-grid-light pointer-events-none absolute inset-0 opacity-25"></div>
					<div class="pointer-events-none absolute -left-20 -top-24 h-64 w-64 rounded-full border border-solar/15"></div>

					<div class="relative z-[2] max-w-[510px]">
						<p class="eyebrow text-solar">Ready when you are</p>
						<h2 id="final-cta-heading" class="display mt-5 text-[2.7rem] leading-[0.96] text-paper sm:text-[3.3rem] lg:text-[3.6rem]">
							Start with a <em class="text-solar">solar assessment.</em>
						</h2>
						<p class="mt-5 max-w-[430px] text-[12.5px] leading-[1.9] text-white/55 sm:text-[13.5px]">
							Tell us where you are and how you use power. We'll help you understand the right
							system, the subsidy and the investment — before you decide.
						</p>

						<div class="mt-8 flex flex-wrap items-center gap-3">
							<a href="#estimate" class="btn-solar">
								Get My Solar Estimate
								<span class="text-[12px] leading-none opacity-75" aria-hidden="true">✦</span>
							</a>
							<a href="tel:+919655046464" class="btn-glass group">
								<Icon name="sun" class="h-4 w-4 text-solar" />
								+91 96550 46464
							</a>
						</div>

						<p class="mt-5 flex items-center gap-2 text-[8.5px] leading-4 text-white/35">
							<span class="h-1 w-1 rounded-full bg-solar" aria-hidden="true"></span>
							Salem, Tamil Nadu · Serving homes and businesses across the state
						</p>
					</div>
				</div>

				<div class="relative min-h-[330px] overflow-hidden lg:min-h-[440px]">
					<img
						src="/images/cta-consultation.webp"
						alt="An engineer and a homeowner reviewing a solar plan beside a solar array"
						width="1800"
						height="1012"
						loading="lazy"
						decoding="async"
						class="absolute inset-0 h-full w-full object-cover object-[58%_32%]"
					/>
					<div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(8,31,27,0.85)_0%,rgba(8,31,27,0.1)_45%,rgba(8,31,27,0.15)_100%)]"></div>
					<div class="absolute inset-0 bg-[linear-gradient(0deg,rgba(4,19,15,0.85)_0%,rgba(4,19,15,0)_45%)]"></div>

					<div class="absolute bottom-4 left-4 right-4 rounded-2xl border border-white/15 bg-ink/55 p-4 backdrop-blur-xl sm:bottom-5 sm:left-5 sm:right-5 sm:p-5">
						<p class="flex items-center gap-2 text-[8px] font-semibold uppercase tracking-[0.16em] text-solar">
							<span class="h-1 w-1 rounded-full bg-solar" aria-hidden="true"></span>
							What happens next
						</p>
						<ol class="mt-3 grid gap-2.5">
							{
								[
									["01", "A quick call about your roof and bill"],
									["02", "A site assessment at your convenience"],
									["03", "A clear proposal, with the numbers"],
								].map(([number, text]) => (
									<li class="flex items-start gap-2.5 text-[9.5px] leading-[1.5] text-white/65">
										<span class="mt-px text-[7px] font-semibold tracking-[0.1em] text-solar/75">{number}</span>
										{text}
									</li>
								))
							}
						</ol>
						<p class="mt-3 border-t border-white/10 pt-2.5 text-[8px] text-white/35">
							No obligation. No pressure.
						</p>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
