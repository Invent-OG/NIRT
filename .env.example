# Zoho Bigin CRM OAuth 2.0 Credentials
# Obtain these from Zoho Developer Console: https://api-console.zoho.in (or .com / .eu depending on your DC)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Zoho Data Centre URLs (Default: India)
# Change domain (.in / .com / .eu / .com.au) to match the data centre where your Zoho Bigin account is hosted.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_URL=https://www.zohoapis.in/bigin/v2

